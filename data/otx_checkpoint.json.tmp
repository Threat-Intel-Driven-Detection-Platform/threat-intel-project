    {
      "id": "6aebe661b7e5525aa39d6ba8",
      "name": "Hackers exploited iOS and Android flaws to infect phones",
      "description": "Hackers potentially linked to Russia's Foreign Intelligence Service exploited previously patched iOS and Android vulnerabilities to target visitors of multiple websites. The operation included impersonating america250.org, a site celebrating American independence, and a luxury UK hotel website near sensitive government institutions where Ukrainian President Zelenskyy stayed. Attackers used JavaScript injection, proxy domains, and compromised a Ukrainian web analytics service to deliver three different zero-click exploit chains, including the DarkSword iOS exploit kit. The attacks aimed to steal browser cookies, Wi-Fi passwords, and device data from diplomatic and high-profile targets related to Ukraine.",
      "author_name": "AlienVault",
      "modified": "2026-11-05T09:41:40.087000",
      "created": "2026-11-05T02:13:53.432000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "APT29",
      "indicators": [
