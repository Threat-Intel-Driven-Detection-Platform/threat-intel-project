    {
      "id": "6afea0678fef8d2ecb316241",
      "name": "Customer Advisory: Guidance Following the Optimizely Supply Chain Incident",
      "description": "On November 16, an unauthorized party exploited a vulnerability in Optimizely Web Experimentation, injecting malicious JavaScript into customer projects. The malicious code, active from 04:21 to 23:11 UTC, could swap cryptocurrency addresses, skim payment card details, steal screenshots and cookies, and deliver exploit kits to vulnerable iOS devices. Analysis identified 188 infected snippets belonging to 178 organizations. The altered scripts were served from Optimizely's content network and customer domains, making detection difficult. Optimizely fixed the vulnerability and removed injected code, though one snippet was re-infected during cleanup. Organizations may be affected through vendor websites visited during the incident window, particularly authentication and payment pages loading Optimizely scripts.",
      "author_name": "AlienVault",
      "modified": "2026-11-19T10:35:25.103000",
      "created": "2026-11-19T07:08:23.964000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
