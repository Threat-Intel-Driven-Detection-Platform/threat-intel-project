    {
      "id": "6ae89f875023c8d646113532",
      "name": "Hackers Use Fake ChatGPT Plus Billing Emails to Steal Credit Card Details and OTP Codes",
      "description": "A sophisticated phishing campaign impersonates OpenAI by sending fraudulent ChatGPT Plus billing emails claiming failed subscription payments. Victims are directed to fake payment pages hosted on compromised WordPress instances under Nexcess's nxcli.io infrastructure. The operation features live attacker involvement, where operators monitor submitted credit card information and dynamically decide whether to request one-time passwords through a real-time polling mechanism. After victims submit payment details including card numbers, expiry dates, CVV codes, and cardholder names, the page maintains a loading animation while the browser polls a backend system approximately every 500 milliseconds. The attackers can then redirect victims to verification-code collection pages to complete fraudulent transactions. The campaign uses distinctive redirect domains and identical client-side code across multiple instances.",
      "author_name": "AlienVault",
      "modified": "2026-11-02T23:25:05.657000",
      "created": "2026-11-02T14:34:47.196000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
      "indicators": [
