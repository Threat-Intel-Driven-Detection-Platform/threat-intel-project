    {
      "id": "6aad3a912f6a15e61e12e20f",
      "name": "Private HTS programs that spread ransomware",
      "description": "Fraudulent organizations in Korea are exploiting private Home Trading System (HTS) software to distribute ransomware to victims. The unauthorized HTS program called 'UBP Asset' impersonates the legitimate Swiss financial institution Union Bancaire Privee (UBP) and has been used in investment scams since at least September 2025. Attackers lure victims through social media platforms like Telegram and KakaoTalk, convincing them to install the fraudulent HTS and deposit funds. The latest campaign involves distributing KRSID ransomware through the HTS update mechanism, which encrypts files using AES-256 and RSA-2048 algorithms. Previous campaigns used similar private HTS programs to distribute Quasar RAT. Victims not only lose their investment funds but also have their systems compromised and files encrypted for ransom demands.",
      "author_name": "AlienVault",
      "modified": "2026-09-18T14:15:12.614000",
      "created": "2026-09-18T13:20:16.496000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
