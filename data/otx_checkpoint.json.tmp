    {
      "id": "6ada5f2001908e1c7f2a85b3",
      "name": "2026 Year End Phishing Lures",
      "description": "As organizations approach year-end and fiscal close periods, employees face increased administrative activity in finance, HR, and IT departments. This heightened legitimate communication creates ideal cover for phishing campaigns. Attackers exploit year-end business processes by impersonating compensation adjustments, Q4 financial documents, access reviews, invoice follow-ups, and benefits statements. Multiple campaigns have been observed targeting organizations across sectors including aviation, telecommunications, manufacturing, real estate, technology, and financial services, with concentration in the Middle East. Attackers leverage SharePoint, Docusign, and Microsoft 365 themes, employing credential harvesting pages disguised as document-sharing portals. Generic protected-message lures prove effective by requiring minimal customization while appearing legitimate during busy periods when employees expect increased document requests and administrative deadlines.",
      "author_name": "AlienVault",
      "modified": "2026-11-22T11:02:10.542000",
      "created": "2026-10-22T19:08:16.326000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
