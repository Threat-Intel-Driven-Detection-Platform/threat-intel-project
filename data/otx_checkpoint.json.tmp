    {
      "id": "6ae095d4e2266adbe75f4ec3",
      "name": "Inside ICMacOS: From an Infostealer to a Persistent RAT",
      "description": "ICMacOS (Icarus macOS) is a newly identified macOS Malware-as-a-Service stealer actively marketed since September 2026 by the Russian-speaking actor GlowComa on underground forums. The malware targets macOS systems running Sierra through current versions on both Intel and Apple Silicon architectures. Initially designed as a credential stealer, it rapidly evolved into a persistent remote access trojan with WebSocket-based command-and-control capabilities. The infection chain uses ClickFix social engineering to deliver dropper scripts that harvest administrator passwords through fake system dialogs before deploying the primary payload. Version 1 focuses on stealing browser credentials, cryptocurrency wallets, developer secrets, messaging data, and password managers. Version 2 introduces full RAT functionality with LaunchAgent persistence and interactive shell access while expanding data collection to include Steam accounts, Outlook data, and additional password managers.",
      "author_name": "AlienVault",
      "modified": "2026-10-27T16:36:47.331000",
      "created": "2026-10-27T12:15:16.671000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "GlowComa",
