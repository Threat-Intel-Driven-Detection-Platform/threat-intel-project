    {
      "id": "6acc3823ee551dd1565f0a27",
      "name": "Inside a brand deal scam targeting YouTube creators",
      "description": "A sophisticated phishing campaign targets YouTube content creators through personalized sponsorship emails impersonating legitimate brands like Hollyland, Nike, and Spotify. Attackers send customized collaboration offers referencing specific videos from targets' channels, then direct them to fraudulent platforms that appear legitimate with campaign metrics and income calculators. The scheme culminates in a Google sign-in request that either captures credentials directly or requests excessive account permissions. Once compromised, attackers lock victims out by changing recovery methods and can misuse the account to spread scams to followers. The modular campaign operates globally, targeting creators in Peru, Japan, and English-speaking regions, using multiple domains while maintaining similar functionality and design patterns across variants.",
      "author_name": "AlienVault",
      "modified": "2026-10-12T23:25:08.274000",
      "created": "2026-10-12T01:30:11.108000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
      "indicators": [
