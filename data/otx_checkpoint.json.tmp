    {
      "id": "6a623272a8b581c080b0aee0",
      "name": "A New Name in the Data Extortion Ecosystem?",
      "description": "A data extortion group called Helix has been identified conducting multi-target campaigns using vishing, device code phishing, and automated SharePoint exfiltration. The group likely emerged from the BlackFile and ShinyHunters ecosystem after BlackFile shut down in April 2026. Helix uses sophisticated social engineering, impersonating managers by name during vishing calls to initiate device code authentication flows. The operation employs shared infrastructure including phishing domains registered through NICENIC with target-specific subdomains. After gaining access, attackers register MFA on compromised accounts, enumerate SharePoint using automated tools with python-requests user-agent, and conduct bulk data exfiltration. Infrastructure analysis reveals connections to BlackFile through hosting on the same autonomous system. The group demonstrates operational flexibility with varying dwell times and uses residential proxies geo-matched to targets to evade detection.",
      "author_name": "AlienVault",
      "modified": "2026-08-22T15:00:29.567000",
      "created": "2026-07-23T15:25:38.608000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "Helix",
      "indicators": [
        {
          "id": 4450722092,
          "indicator": "oskeysync.com",
          "type": "domain",
          "created": "2026-07-23T15:25:39",
          "content": "",
          "title": "",
          "description": "",
          "expiration": null,
          "is_active": 1,
          "role": null
        }
      ],
      "tags": [
