    {
      "id": "6ad0e1295c816b236074f6a2",
      "name": "skynox7: Proxyjacking Edge Devices Into Residential Proxies",
      "description": "A malicious cyber actor conducted a proxyjacking campaign, compromising at least 143 network edge devices across 34 countries to force them into residential proxy networks. The attacker exploited vulnerabilities in D-Link ShareCenter NAS devices, Ubiquiti UniFi Video NVR systems, and SAP NetWeaver Visual Composer, also targeting DVR/NVR devices from Hikvision and Dahua. The compromised devices were installed with Pawns.app software without owners' consent, monetizing victim bandwidth through IPRoyal's residential proxy network. The attacker configured SSH key authentication as a persistent access method. This activity was discovered when an organization identified suspicious authentication patterns showing multiple users logging in from the same residential proxy IP address, leading to confirmation of a serious intrusion.",
      "author_name": "AlienVault",
      "modified": "2026-10-16T07:30:29.002000",
      "created": "2026-10-15T14:20:25.839000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "skynox7",
