    {
      "id": "6ada5f1fcf9561726fe676ad",
      "name": "ARTEX in the Wild: Storm-0940 Expands Targeting of IT and Software Vendors",
      "description": "Throughout October 2026, an actor utilizing ARTEX, an autonomous AI penetration-testing agent, targeted multiple IT and software vendors with attacks focused on identity providers including Okta, Entra, and Cognito. The activity overlaps with Storm-0940, a Chinese-state aligned actor involved in supply-chain attacks. Observed methodologies included mapping applications through JavaScript bundles and source maps, probing authentication mechanisms, manipulating OAuth callbacks, password-spraying corporate environments, abusing account recovery endpoints, and testing tenant isolation. Sessions lasted 24-30 hours with automatic IP rotation when blocked. The agent demonstrated agentic behavior through automated step chaining, output-based adaptation, and relentless iteration. Attacks featured coordinated bursts with unique user agents, one-second intervals between attempts, and targeting of software engineers across hundreds of users.",
      "author_name": "AlienVault",
      "modified": "2026-11-22T11:02:10.542000",
      "created": "2026-10-22T19:08:15.438000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "Storm-0940",
      "indicators": [],
      "tags": [
        "autonomous ai agent",
        "oauth manipulation",
        "artex",
        "supply chain attack"
      ],
      "targeted_countries": [],
      "malware_families": [
        "ARTEX"
      ],
      "attack_ids": [
        "T1133",
