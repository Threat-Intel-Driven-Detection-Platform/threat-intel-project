    {
      "id": "6afd5d540e49984e613c22ce",
      "name": "agent-framework Compromised: Credential Stealer Targets Azure and CI Pipelines",
      "description": "On November 17, 2026, two malicious versions (1.26.1 and 1.26.2) of Microsoft's agent-framework Python package were published to PyPI for approximately 50 minutes before removal. The compromised packages deployed credential stealers through Python .pth files that executed automatically on interpreter startup. The malware targeted Azure and CI/CD environments, extracting environment variables containing secrets, credential files from Azure CLI, Docker, Git, and package managers, plus Azure managed-identity and OIDC tokens. Version 1.26.2 enhanced capabilities to steal GitHub Actions OIDC tokens from workflows with federated credential access. Stolen data was exfiltrated via a hardcoded webhook.site URL. The root cause appears to be unauthorized direct upload to PyPI outside the normal release process, though this has not been confirmed.",
      "author_name": "AlienVault",
      "modified": "2026-11-18T09:32:26.925000",
      "created": "2026-11-18T08:09:56.613000",
      "revision": 4,
      "tlp": "white",
      "public": 1,
      "adversary": "",
      "indicators": [
        {
          "id": 4589503135,
          "indicator": "d27fa34414e6201d5e03e559ef634f020057554d7b3f4898dd5d7cd3e989e110",
          "type": "FileHash-SHA256",
          "created": "2026-11-18T08:09:57",
          "content": "",
