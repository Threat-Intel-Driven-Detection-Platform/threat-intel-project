    {
      "id": "6aa1c27fd351a18fbe0a8219",
      "name": "Passkey-themed social engineering leads to identity and cloud compromise",
      "description": "Multiple cloud accounts have been compromised through passkey-themed social engineering campaigns since May 2026. Attackers impersonate IT helpdesk staff via phone calls or SMS, directing victims to phishing sites that mimic Microsoft sign-in pages. After obtaining credentials through adversary-in-the-middle or device code authentication flows, attackers establish persistence by adding unauthorized MFA methods. They then conduct extensive reconnaissance using Microsoft Graph API to map users, groups, permissions, and resources. The intrusion culminates in high-volume data collection from SharePoint, OneDrive, and Exchange using automated tools, with exfiltration occurring over hours or days at controlled rates to avoid detection.",
      "author_name": "AlienVault",
      "modified": "2026-09-10T05:54:53.522000",
      "created": "2026-09-09T20:33:03.691000",
      "revision": 3,
      "tlp": "white",
      "public": 1,
      "adversary": "Storm-3121, Storm-3032",
