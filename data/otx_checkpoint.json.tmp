    {
      "id": "6ad8db024c84442cd0085496",
      "name": "INC and The Gentlemen Ransomware: Exposed AI Infrastructure",
      "description": "Threat researchers discovered an AI-driven intrusion ecosystem operated by affiliates of INC Ransomware and The Gentlemen Ransomware groups through seven exposed command-and-control servers. The operators integrated commercial AI models via OpenCode and OpenRouter, logging over 8,000 messages across 133 sessions with recorded spending exceeding $23,000. They exploited edge devices at scale including FortiClient EMS, SimpleHelp, and cPanel systems, compromising thousands of targets. The infrastructure contained 46 custom INC encryptor builds staged for October 1, 2026 deployment, evidence of live victim encryption, and a custom arsenal including the Phantom autonomous framework, Ghost C2, and various exploitation tools. The campaign targeted 62 named organizations, predominantly in the United States, with focus on industrial manufacturing and healthcare sectors. OPSEC failures in late September 2026 exposed source code, credentials, AI session logs, and complete victim knowledge bases.",
      "author_name": "AlienVault",
      "modified": "2026-11-21T10:01:53.317000",
      "created": "2026-10-21T15:32:18.507000",
      "revision": 3,
      "tlp": "white",
      "public": 1,
      "adversary": "INC Ransom, The Gentlemen",
