    {
      "id": "6ac6bb9cd16a3898ced29ead",
      "name": "DarkSword/Coruna Open Directory Finding",
      "description": "Five hosts exposed the complete DarkSword/Coruna iOS exploitation platform through open directories, revealing an active commercial exploitation-as-a-service operation. The platform targets cryptocurrency wallets across 18 different applications, extracting BIP39 recovery phrases and conducting automated theft. Analysis of the production server recovered 11 victim recovery phrases, 179 device loot directories, and a 75-account control-plane roster indicating an agent/reseller model. A separate China-based operator is deploying identical tooling through independent infrastructure at 66ds[.]lol, representing a distinct threat actor from previously documented DarkSword users. The infrastructure was operationally active during analysis, with beacon telemetry showing Chinese iOS devices polling every three seconds for hours. Development work targeting iOS 26 via CVE-2026-31001 was discovered but remains undeployed.",
      "author_name": "AlienVault",
      "modified": "2026-11-06T21:00:25.880000",
      "created": "2026-10-07T21:37:32.724000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
