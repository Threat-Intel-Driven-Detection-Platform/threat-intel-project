    {
      "id": "6af61f931cd135114986ff2c",
      "name": "Luna Moth Returns, Re-Targeting Law Firms Through Access Tokens",
      "description": "The extortion group Luna Moth is re-targeting law firms that previously declined to pay ransom demands, employing a novel token-based exfiltration technique. Attackers impersonate IT support via video calls, convincing victims to extract Microsoft Graph access tokens from Microsoft 365 Copilot through browser developer tools. These stolen tokens bypass MFA and Conditional Access controls since validation occurs only at issuance, enabling bulk file downloads within approximately one hour. The group has simplified its attack chain from earlier campaigns that relied on multiple remote-management tools and manual exfiltration. This shift represents a broader trend toward identity-focused attacks that avoid malware and endpoint detection. Organizations should implement Continuous Access Evaluation with strict location enforcement to invalidate tokens used outside authorized networks.",
      "author_name": "AlienVault",
      "modified": "2026-11-13T09:55:13.291000",
      "created": "2026-11-12T20:20:35.298000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "Luna Moth",
      "indicators": [
