    {
      "id": "6ada5f1fb2e3c0d3b77b8ceb",
      "name": "TRUST#GRAFT : JavaScript-Compromised Sites Target WordPress Admin Browsers to Deploy a Persistent PHP Backdoor",
      "description": "TRUST#GRAFT is a sophisticated attack chain that exploits authenticated WordPress administrator browser sessions to deploy persistent PHP backdoors. The attack begins with JavaScript loaders that present fake Cloudflare-style verification screens while performing browser fingerprinting, credential harvesting from browser storage, and environment profiling. The critical pivot occurs when the script detects an active WordPress administrator session, automatically extracting CSRF tokens and uploading a malicious plugin disguised as 'Web Media Optimizer.' The PHP backdoor establishes persistence by copying itself to the must-use plugins directory, injects remote JavaScript into public pages, provides token-gated administrator access, and conceals itself from standard plugin management interfaces. The chain demonstrates coordinated infrastructure across multiple domains and requires no authentication bypass, instead leveraging existing trusted browser sessions to convert legitimate administrator workflows into ...",
      "author_name": "AlienVault",
      "modified": "2026-10-23T11:37:32.104000",
      "created": "2026-10-22T19:08:15.770000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
      "indicators": [
        {
          "id": 2937727601,
          "indicator": "gerlace.com",
          "type": "domain",
          "created": "2026-10-22T19:08:16",
          "content": "",
          "title": "",
