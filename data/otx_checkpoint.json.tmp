    {
      "id": "6afabb0c724e4715eb97f1c1",
      "name": "WardenStealer Malware: Turning AI Access into an Underground Commodity",
      "description": "WardenStealer is a Rust-based Windows infostealer first observed in November 2026 that specializes in stealing credentials, authentication tokens, cookies, API keys, and local AI application files targeting platforms like ChatGPT, Claude, Codex, GitHub Copilot, and Cursor. Distributed through ClickFix lures, malicious advertisements, cracked software, and fake game cheats, it enables session hijacking that persists even after password resets. The malware operates as malware-as-a-service and captures OAuth tokens, refresh tokens, and configuration data from AI desktop applications. Stolen credentials are monetized in underground markets through discounted subscriptions and API credit reselling, supporting LLMjacking activities. Successful infections expose developer repositories, cloud services, build pipelines, and internal systems, while generating unexpected charges against victim accounts through unauthorized API usage.",
      "author_name": "AlienVault",
      "modified": "2026-11-16T10:50:28.560000",
      "created": "2026-11-16T08:13:00.562000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
