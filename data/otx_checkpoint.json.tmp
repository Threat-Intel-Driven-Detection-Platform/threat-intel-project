    {
      "id": "6ae48b699d02200fbf388334",
      "name": "September 2026 Threat Trend Report on APT Attacks (South Korea)",
      "description": "During September 2026, multiple APT attack campaigns targeting South Korean entities were identified, primarily delivered through spear phishing emails. The attacks utilized various techniques including LNK files with embedded PowerShell scripts, HTA files downloaded via curl.exe, and malicious DLL files. Five distinct attack types were classified (Type A through D, plus Unknown). These campaigns deployed AutoIt scripts, Infostealers, keyloggers, backdoors including XenoRAT, and established persistence through Task Scheduler entries. Attackers leveraged legitimate services like GitHub, Google Drive, and PubNub for command and control operations. The malicious files were disguised as legitimate documents to deceive users, ultimately exfiltrating system information, credentials, and virtual asset data while maintaining persistent access to compromised systems.",
      "author_name": "AlienVault",
      "modified": "2026-11-02T22:33:36.402000",
      "created": "2026-10-30T12:19:53.024000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "Kimsuky",
