    {
      "id": "6ac7415f2754c1b2193c9737",
      "name": "TensorLake npm SDK Compromised in ChainDrop Shai-Hulud Credential-Stealing Attack",
      "description": "The Tensorlake npm SDK version 0.5.144 was compromised in a ChainDrop/Shai-Hulud supply chain attack, affecting a package with approximately 12,000 weekly downloads. The malicious release contains obfuscated code that harvests credentials from multiple sources including npm tokens, GitHub tokens, AWS credentials, HashiCorp Vault, Kubernetes configurations, SSH keys, and AI development tools. A preinstall hook executes the payload during installation, establishing persistence through scheduled tasks and supporting remote code execution. The attack uses an Ethereum contract to resolve command-and-control endpoints and implements a dead-man switch that monitors stolen GitHub tokens, triggering destructive actions if revoked. The malicious code can self-propagate by republishing compromised versions to other packages associated with the victim's publishing identity, extending the worm's reach across the npm ecosystem.",
      "author_name": "AlienVault",
      "modified": "2026-10-08T08:02:22.173000",
      "created": "2026-10-08T07:08:15.285000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
