{
  "results": [
    {
      "id": "6b047274d961f9811fa48f1c",
      "name": "Agentic Attacks in the Wild: ARTEX & Offensive AI Frameworks",
      "description": "Between late September and November 2026, cloud environments experienced a surge in automated intrusions driven by agentic offensive frameworks, particularly ARTEX and its variants including Cairn, CyberStrikeAI, and HexStrike. These attacks leverage AI-driven automation to conduct noisy, vector-agnostic campaigns that spray credentials, probe endpoints, and abuse multiple access methods including stolen cloud keys, OAuth flows, and CI/CD trust relationships. Operators route attacks through residential proxy networks making IP-based blocking ineffective. Once initial access is achieved, agents systematically harvest credentials, explore lateral movement opportunities, and exfiltrate sensitive data including API keys and secrets. Poor operational security by attackers has resulted in exposed command-and-control panels revealing both attacker prompts and AI reasoning, providing unprecedented visibility into these machine-speed operations targeting cloud infrastructure and AI platform credentials.",
      "author_name": "AlienVault",
      "modified": "2026-11-23T17:23:24.537000",
      "created": "2026-11-23T17:05:56.683000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
