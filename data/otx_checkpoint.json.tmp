    {
      "id": "6afc64c10725d6ed55140f7e",
      "name": "Optimizely Attack Hits Zoom, BBC, CNN With Skimmer, iOS Kits",
      "description": "On November 16, 2026, attackers exploited a vulnerability in Optimizely's Experimentation product to inject malicious JavaScript into 188 customer projects, affecting major organizations including Zoom, BBC, CNN, IKEA, HSBC and Equifax. For nearly 19 hours, visitors to these sites received code that swapped cryptocurrency addresses, skimmed payment card data, and delivered iOS exploit kits to iPhone and iPad users. The payload included cryptocurrency clippers for multiple blockchains, a card skimmer targeting first-party checkout forms, context theft capturing cookies and screenshots, and iOS exploit chains (Coruna and DarkSword kits) targeting devices running iOS 13 through 18.6. Attackers collected approximately $7,150 in cryptocurrency, though the full extent of stolen card data and compromised iOS devices remains unknown. All infected files were cleaned by 23:11 UTC on November 16.",
      "author_name": "AlienVault",
      "modified": "2026-11-18T07:48:24.246000",
      "created": "2026-11-17T14:29:21.827000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
