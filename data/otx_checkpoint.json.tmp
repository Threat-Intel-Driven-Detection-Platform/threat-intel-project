    {
      "id": "6ab431db415b8cd13de69a7e",
      "name": "This Windows Malware is Built to Let Up to Four AI Models Vote on Its Next Move",
      "description": "A Windows malware called CLOSEDQUORUM is built to take orders from a vote of up to four AI models instead of an attacker's server, Cisco Talos said on September 22. The models can choose to steal Windows credentials, saved browser passwords, and crypto wallet data. Talos has not seen this setup work from start to finish, and the public version of the malware does not work as it is.",
      "author_name": "AlienVault",
      "modified": "2026-09-23T20:08:58.725000",
      "created": "2026-09-23T20:08:58.725000",
