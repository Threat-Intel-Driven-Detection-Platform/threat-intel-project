    {
      "id": "6ae38bc5104a1b7a03e20f92",
      "name": "Node2Shell (CVE-2026-111497): Brotli RCE Exploited",
      "description": "A critical out-of-bounds write vulnerability in Google's Brotli decompression library allows specially crafted compressed data to corrupt application memory, potentially enabling remote code execution. The flaw, scoring 9.2 CVSS v4.0, affects Google Brotli versions 1.0.3 through 1.2.0 and impacts multiple platforms including Node.js, Bun, Python implementations, and .NET frameworks. Exploitation attempts were observed within days of patch availability, with working proof-of-concept code demonstrating remote code execution against Node.js environments through malicious HTTP requests and responses. CISA added the vulnerability to its KEV catalog on October 27, 2026. The vulnerability can be triggered through various attack vectors including incoming HTTP requests with Brotli-compressed bodies, malicious server responses, and file processing workflows. Enterprise products from Palo Alto Networks and VMware are also affected, expanding the attack surface beyond typical Node.js deployments.",
      "author_name": "AlienVault",
      "modified": "2026-10-30T00:19:43.408000",
      "created": "2026-10-29T18:09:09.918000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
