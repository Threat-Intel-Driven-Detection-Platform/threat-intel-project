    {
      "id": "6ad187349cefc9d2193e5cc3",
      "name": "AI-Powered Espionage Campaign Targets Government Linux Infrastructure",
      "description": "An espionage campaign tracked as CL-UNK-1211 targeted government entities and state-affiliated infrastructure between October 2025 and April 2026, utilizing AI-generated payloads containing conversational annotations suggesting LLM or automated AI agent involvement. Attackers focused on Linux environments deploying web shells, custom cross-platform backdoors including SysGoRAT malware, and open-source tools to maintain persistent access. Operations included extensive reconnaissance, database dumping, mailbox enumeration targeting social media accounts linked to government emails, and sophisticated defense evasion techniques such as disabling endpoint protections, erasing system logs, and planting deceptive red-team markers to disguise malicious activity as legitimate security assessments.",
      "author_name": "AlienVault",
      "modified": "2026-11-15T02:06:05.825000",
      "created": "2026-10-16T02:08:52.038000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "CL-UNK-1211",
