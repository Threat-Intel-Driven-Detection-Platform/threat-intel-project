    {
      "id": "6af6c5535313263a193f072b",
      "name": "Beware of Phishing Email Disguised as Purchase Order Confirmation Request (Xloader)",
      "description": "A phishing campaign distributes XLoader infostealer through emails disguised as purchase order confirmation requests. The attack chain begins with a malicious DOCX file that exploits Word's altChunk feature to execute an embedded RTF document. This RTF exploits CVE-2017-11882 through OLE objects to execute a VBS script, which drops encoded data and launches PowerShell scripts. The PowerShell scripts establish persistence through registry modifications and deploy a loader that decrypts and executes XLoader version 8.9 in memory. The final payload steals system information, browser credentials, and can download additional malware while communicating with its command and control server.",
      "author_name": "AlienVault",
      "modified": "2026-11-13T09:33:45.974000",
      "created": "2026-11-13T08:07:47.775000",
      "revision": 2,
      "tlp": "white",
