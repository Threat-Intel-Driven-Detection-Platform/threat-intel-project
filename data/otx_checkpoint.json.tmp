    {
      "id": "6ac7b505bae48a926c79fefb",
      "name": "From Guest Complaints to Malware: Blockchain Abuse Targets Hotels",
      "description": "Threat actors are conducting email campaigns targeting the accommodation industry using fake guest complaints, reviews, and inquiries. These emails deliver malicious LNK shortcut files disguised as images, which ultimately deploy blockchain-abusing malware families known as EtherRAT and TONResolver. Both malware types resolve command and control infrastructure by querying public blockchain APIs (Ethereum and TON respectively) instead of using hardcoded domains. This technique allows operators to rotate infrastructure cheaply through small blockchain transactions while making traditional takedown efforts ineffective. The campaigns represent an evolution from earlier Booking.com-spoofing operations that used ClickFix fake CAPTCHAs to deliver remote access trojans. The threat actors likely employ generative AI to create unique email variants, making detection more challenging.",
      "author_name": "AlienVault",
      "modified": "2026-10-09T08:06:35.572000",
      "created": "2026-10-08T15:21:41.957000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
