    {
      "id": "6afd5d22755125a9b65a6dcb",
      "name": "Active DGA Phishing and Polymorphic WebView Trojans Targeting Romanian Users - NACE Exchange / TroveX",
      "description": "A sophisticated financial fraud campaign is actively targeting Romanian users through fake cryptocurrency exchange platforms branded as NACE Exchange and TroveX. The operation employs domain generation algorithms to rapidly rotate phishing domains that mimic legitimate crypto exchanges, harvesting credentials and personal data. Malicious Android APK files and iOS provisioning profiles are distributed as fake trading applications, functioning as WebView wrappers with embedded tracking infrastructure. These trojans request extensive permissions including GPS location tracking, clipboard access, contacts, and storage to exfiltrate sensitive data. The campaign has been documented across multiple European countries and utilizes personas like Professor Herbert Phillip. Infrastructure endpoints are frequently rotated to evade detection, making this a persistent transnational threat.",
      "author_name": "AlienVault",
      "modified": "2026-11-18T09:19:46.517000",
      "created": "2026-11-18T08:09:06.686000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
