    {
      "id": "6ac6369136830294944bbdc8",
      "name": "Behind the Connect Button: The Fake AI Ads Campaign",
      "description": "Security researchers uncovered a sophisticated human-operated phishing platform disguising itself as AI advertising products for major platforms including Muse, Gemini, Claude, ChatGPT, and Perplexity. The campaign uses a Browser-in-the-Browser technique, creating fake authentication windows that appear legitimate while remaining on phishing domains. When victims click 'Connect' buttons, operators intercept credentials and MFA challenges in real-time through a state machine that can retry passwords and adapt to different authentication methods. The platform targets advertising account managers and recruiters, with infrastructure built on Next.js and Socket.IO, reusing the same codebase across multiple brand impersonations. The operation extends beyond AI products to include refund scams and fake recruitment sites, all connected through shared backend infrastructure on Railway and Render hosting services.",
      "author_name": "AlienVault",
      "modified": "2026-10-07T13:15:43.478000",
      "created": "2026-10-07T12:09:53.578000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
      "indicators": [
