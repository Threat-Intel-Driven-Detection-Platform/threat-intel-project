    {
      "id": "6ac6796b14fb153d2a5f5a04",
      "name": "Phishing Campaign Abuses Microsoft Power BI to Deploy Rogue RMMs",
      "description": "In September, a phishing campaign exploited legitimate Microsoft Power BI domains to distribute rogue ScreenConnect remote monitoring tools. Attackers sent phishing emails with embedded links redirecting victims to fake reference documents hosted on Power BI infrastructure. Clicking 'Download Reference' opened attacker-controlled websites that fingerprinted victims' systems and browsers before triggering malicious ScreenConnect installer downloads. The attack deployed multiple ScreenConnect instances for persistent remote access, with the second client connected to attacker infrastructure. Following deployment, threat actors executed defense evasion tools and created scheduled tasks running persistence scripts every two minutes. The campaign used browser fingerprinting and Telegram bots to filter victims and track infections, while abusing trusted Microsoft domains to bypass email security controls and increase attack credibility.",
      "author_name": "AlienVault",
      "modified": "2026-10-08T08:02:51.094000",
      "created": "2026-10-07T16:55:07.392000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
