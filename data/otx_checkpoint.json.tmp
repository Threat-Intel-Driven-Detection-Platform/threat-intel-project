        {
          "id": 4596140863,
          "indicator": "da0b4e348cba4e4ea37e79e61a2d452894d28175",
          "type": "YARA",
          "created": "2026-11-20T11:55:49",
          "content": "rule G_Hunting_Webshell_SLIMSAVAGE_1 {\n      meta:\n        author = \"Google Threat Intelligence Group\"\n      strings:\n        $s1 = \"if(\\\"123\\\".equals(request.getParameter(\\\"pwd\\\")))\" ascii wide\n        $s2 = \"new ProcessBuilder(\\\"/bin/sh\\\",\\\"-c\\\",request.getParameter(\\\"i\\\"))\" ascii wide\n        $s3 = \"InputStream a = p.getInputStream(), b = p.getErrorStream();\" ascii wide\n        $s4 = \"while((c=a.read(d))!=-1){out.print(new String(d,0,c));}\" ascii wide\n        $s5 = \"catch(Exception e){out.print(\\\"ERR:\\\"+e);}\" ascii wide\n    \n      condition:\n        all of ($s*)\n    }",
          "title": "G_Hunting_Webshell_SLIMSAVAGE_1",
          "description": "",
          "expiration": null,
          "is_active": 1,
          "role": null
        },
        {
          "id": 4596140864,
          "indicator": "25567369ea9f32e0139daa822a3858940b7a6a39",
          "type": "YARA",
          "created": "2026-11-20T11:55:49",
          "content": "rule G_Hunting_Webshell_CAGEMATCH_1 {\n      meta:\n        author = \"Google Threat Intelligence Group\"\n      strings:\n        $s1 = \"request.getContentType().split(\\\"boundary=\\\")\" ascii wide\n        $s2 = \"String s=new String(d,\\\"ISO-8859-1\\\");int fi=s.indexOf(\\\"filename=\\\\\\\"\\\");\" ascii wide\n        $s3 = \"String fname=new File(s.substring(fs,fe)).getName();\" ascii wide\n        $s4 = \"int so=s.substring(0,ds).getBytes(\\\"ISO-8859-1\\\").length;\" ascii wide\n        $s5 = \"File f=new File(\\\"/tmp\\\");f.mkdirs();File fout=new File(f,fname);\" ascii wide\n    \n      condition:\n        4 of ($s*)\n    }",
          "title": "G_Hunting_Webshell_CAGEMATCH_1",
          "description": "",
          "expiration": null,
          "is_active": 1,
          "role": null
        },
        {
          "id": 4596140865,
          "indicator": "48cc8b6981fb60b5d2e9a333f1e5d4dcbdca4822",
          "type": "YARA",
          "created": "2026-11-20T11:55:49",
          "content": "rule G_Hunting_Utility_SAWSNAKE_2 {\n        meta:\n            author = \"Google Threat Intelligence Group\"\n        strings:\n            $src1 = \"saml_login/mdb.go\" ascii\n            $src2 = \"saml_login/saml.go\" ascii\n            $src3 = \"saml_login/c14n.go\" ascii\n            $s1 = \"[+] Successfully obtained Administrator cookies for %s!\" ascii\n            $s2 = \"[*] Successfully extracted trusted certificate 1\" ascii\n            $s3 = \"[*] Successfully extracted the IdP certificate\" ascii\n            $s4 = \"https://%s/ui/saml/websso/sso\" ascii\n            $s5 = \"effective SSO host for the exchange: %q\" ascii\n            $s6 = \"assertion canonicalized for digest: %d bytes, sha256=%s\" ascii\n        condition:\n            uint32(0) == 0x464c457f and (2 of ($src*) or 4 of ($s*))\n    }",
          "title": "G_Hunting_Utility_SAWSNAKE_2",
          "description": "",
          "expiration": null,
          "is_active": 1,
          "role": null
        },
        {
          "id": 4596140866,
          "indicator": "be425b31b82ca3e929e81b26c67a39b450afc7e8",
          "type": "YARA",
          "created": "2026-11-20T11:55:49",
          "content": "rule G_Hunting_Utility_BONESAW_2 {\n  meta:\nauthor = \"Google Threat Intelligence Group\" \n  strings:\n    $s_mdb_path = \"/storage/db/vmware-vmdir/data.mdb\" ascii\n    $s_srp_prime_n = \"AC6BDB41324A9A9BF166DE5E1389582FAF72B6651987EE07FC3192943DB56050\" ascii\n    $s_uuid_dbcp = \"72c780fe-af6b-42ba-9b02-f61f4ccc98ed\" ascii nocase\n    $c_uuid_dbcp = { fe 80 c7 72 6b af ba 42 9b 02 f6 1f 4c cc 98 ed }\n    $s_uuid_srp_verf = \"c7e94609-6ab0-4767-8e92-b6485bff1649\" ascii nocase\n    $c_uuid_srp_verf = { 09 46 e9 c7 b0 6a 67 47 8e 92 b6 48 5b ff 16 49 }\n\n  condition:\n    uint32(0) == 0x464C457F\n    and $s_mdb_path\n    and $s_srp_prime_n\n    and ($s_uuid_dbcp or $c_uuid_dbcp)\n    and ($s_uuid_srp_verf or $c_uuid_srp_verf)\n}",
          "title": "G_Hunting_Utility_BONESAW_2",
          "description": "",
          "expiration": null,
          "is_active": 1,
          "role": null
        },
        {
          "id": 4596140867,
          "indicator": "2826a6a84bdbf7abaca13cb15c85f04a255eb728",
          "type": "YARA",
          "created": "2026-11-20T11:55:49",
          "content": "rule G_Hunting_Backdoor_BEARBONES_1 {\n      meta:\n        author = \"Google Threat Intelligence Group\"    \n      strings:\n        $c_sha256_len = { BA 0E 00 00 00 4C 89 E7 48 89 EE }\n        $s_banner = \"SSH-2.0-pulsesecure_\" ascii\n        $s_rsa_key = \"/tmp/rsa_host_key\" ascii\n        $s_ecdsa_key = \"/tmp/ecdsa_host_key\" ascii\n        $s_dss_key = \"/tmp/dss_host_key\" ascii\n    \n      condition:\n        uint32(0) == 0x464C457F\n        and ($c_sha256_len or $s_banner)\n        and 2 of ($s_*)\n    }",
          "title": "G_Hunting_Backdoor_BEARBONES_1",
          "description": "",
          "expiration": null,
          "is_active": 1,
          "role": null
        },
        {
          "id": 4596140868,
          "indicator": "585077abf2428fb596ab8229ec6c353fd52fd206",
          "type": "YARA",
          "created": "2026-11-20T11:55:49",
          "content": "rule G_Hunting_Backdoor_LAZYBONES_1 {\n    meta:\n        author = \"Google Threat Intelligence Group\"\n    strings:\n        $fn1 = \"main.AesCtfCrypt_fromconf\" ascii wide\n        $fn2 = \"main.AesCtfDecrypt_fromconf\" ascii wide\n        $fn3 = \"main.uploadSlackFile\" ascii wide\n        $fn4 = \"main.getLastMessage\" ascii wide\n        $fn5 = \"main.exec_my\" ascii wide\n        $api1 = \"https://slack.com/api/files.getUploadURLExternal\" ascii wide\n        $api2 = \"https://slack.com/api/files.completeUploadExternal\" ascii wide\n        $api3 = \"https://slack.com/api/conversations.history\" ascii wide\n        $str1 = \"ok,current sleep is:\" ascii wide\n        $str2 = \"get but not function\" ascii wide\n        $str3 = \"readfile fail:\" ascii wide\n    condition:\n        uint32(0) == 0x464c457f and\n        (\n            3 of ($fn*) or\n            (2 of ($api*) and 2 of ($str*))\n        )\n}",
          "title": "G_Hunting_Backdoor_LAZYBONES_1",
          "description": "",
          "expiration": null,
          "is_active": 1,
          "role": null
        }
