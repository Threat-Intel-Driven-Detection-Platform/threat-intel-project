    {
      "id": "6ad8969bac267e8087601c01",
      "name": "Recent AI-Assisted Cyber Attacks in Japan: Investigating Attack Infrastructure and Techniques",
      "description": "In October 2026, multiple organizations in Japan experienced unauthorized access incidents resulting in personal information leakage. Investigations revealed that attackers leveraged artificial intelligence to scan for known vulnerabilities and execute attacks through APIs. The threat actors analyzed Android application packages to identify and exploit APIs, testing for vulnerabilities including server-side request forgery. Multiple attack servers were identified containing tools for reverse engineering Flutter applications, analyzing Android apps, and targeting web applications, MySQL databases, Jenkins servers, and email gateways. Evidence suggests attempts to evade endpoint detection and response systems and deploy web shells for internal network access. The attacks also targeted web services beyond Japan, demonstrating a broader scope of malicious activity.",
      "author_name": "AlienVault",
      "modified": "2026-11-21T00:04:03.895000",
      "created": "2026-10-21T10:40:27.154000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
      "indicators": [],
