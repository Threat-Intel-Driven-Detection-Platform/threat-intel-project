    {
      "id": "6afdaa416a4121d2f40898b5",
      "name": "Optimizely Supply Chain Attack Distributes Malware Across Global Brands",
      "description": "An attacker exploited a vulnerability in Optimizely's Web Experimentation platform on November 16, 2026, compromising 188 JavaScript snippets across 178 organizations including BBC, CNN, Zoom, GitLab, IKEA, and HSBC. The exploit targeted the optional Project JavaScript field in Optimizely's A/B testing service, allowing malicious code injection through trusted infrastructure. Visitors to affected websites were exposed to cryptocurrency wallet address clippers that replaced legitimate addresses with attacker-controlled ones, payment card skimmers, and iOS-specific exploit kits. The attack leveraged encoded JavaScript modules that intercepted clipboard operations, monitored page content through MutationObservers, and delivered platform-specific payloads. Optimizely patched the vulnerability, removed injected code, revoked tokens, and reset affected accounts by November 16 at 23:11 UTC.",
      "author_name": "AlienVault",
      "modified": "2026-11-19T10:46:03.279000",
      "created": "2026-11-18T13:38:09.592000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
