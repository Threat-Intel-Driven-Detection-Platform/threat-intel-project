    {
      "id": "6ace37f3bfe7f0829254f7bf",
      "name": "Kimsuky attacks targeting Ukrainian experts in diplomacy, security, and international policy",
      "description": "The Kimsuky threat group has launched spear phishing campaigns targeting Ukrainian experts in diplomacy, security, and international policy through fraudulent international conference invitations and collaboration requests. This operation, dubbed GitPower, leverages legitimate development platforms like GitHub for malware distribution and data exfiltration. Attack vectors include malicious LNK files and fake Zoom installers, demonstrating links to previous CHM-based attack methodologies. The campaign appears to be state-sponsored cyber espionage focused on monitoring cooperation developments between South Korea and Ukraine. Organizations are advised to enhance EDR detection capabilities and implement threat hunting for suspicious LNK file execution, PowerShell abuse, and unauthorized GitHub communications.",
      "author_name": "AlienVault",
      "modified": "2026-11-12T13:01:07.918000",
      "created": "2026-10-13T13:53:55.845000",
      "revision": 3,
      "tlp": "white",
      "public": 1,
      "adversary": "Kimsuky",
