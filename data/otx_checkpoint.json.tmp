    {
      "id": "6ac679e7bbe47190f9ffce7a",
      "name": "FortiBleed Operations Continue Targeting Exposed Systems Leading to Reports of Lockouts",
      "description": "FortiBleed is an active global credential-compromise campaign targeting internet-facing Fortinet FortiGate firewalls and SSL VPN gateways, with over 86,644 compromised devices verified across 194 countries. The campaign exploits reused or leaked credentials and legacy SHA-256 password storage, enabling threat actors to harvest and crack authentication data at scale using distributed GPU clusters. Attackers scan for exposed FortiGate SSL VPN portals, collect credentials through stuffing and password spraying, and crack stolen password hashes offline. Once access is gained, they create new administrative accounts for persistence and conduct Active Directory enumeration to expand access. Affected organizations may experience lockouts as threat actors delete or modify existing accounts. The operation functions as an initial-access broker, with connections observed to INC/Lynx and Payload ransomware affiliates, representing a significant threat requiring immediate defensive action.",
      "author_name": "AlienVault",
      "modified": "2026-11-06T16:03:39.952000",
      "created": "2026-10-07T16:57:11.669000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
      "indicators": [],
