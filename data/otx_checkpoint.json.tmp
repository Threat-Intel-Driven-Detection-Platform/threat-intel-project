    {
      "id": "6a30d0b403db287f819b47e9",
      "name": "WebAssembly Malware Found in Trojanized Open VSX Extensions",
      "description": "Trojanized Visual Studio Code extensions distributed via the Open VSX marketplace deliver a sophisticated WebAssembly-based attack chain. The extensions ship ChaCha20-encrypted TinyGo-compiled WebAssembly modules that poll the Solana blockchain for command-and-control instructions embedded in transaction memos. This novel dead-drop technique allows attackers to rotate infrastructure without hardcoded servers. Once activated, the modules read attacker instructions from a monitored Solana wallet address, then execute platform-specific download-and-execute commands via Node.js child_process to deploy second-stage payloads. The campaign impersonates legitimate extensions on Open VSX, exploiting cross-registry trust gaps to target VSCodium, Cursor, Windsurf, and other VS Code forks. Attribution points to GlassWorm-associated tradecraft with medium confidence, representing a new WebAssembly-based variant of previously documented supply chain compromise techniques.",
      "author_name": "AlienVault",
      "modified": "2026-07-16T04:02:57.605000",
      "created": "2026-06-16T04:27:32.065000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "GlassWorm",
