    {
      "id": "6aeca135ab4fb550bdc9ee28",
      "name": "CWPdoor: The Invisible Backdoor Living Inside Control Web Panel",
      "description": "A sophisticated passive backdoor named cwpdoor has been discovered targeting Control Web Panel (CWP), a free open-source server management control panel for Linux. The malware embeds malicious code directly into the legitimate cwpsrv binary and is triggered only by specially crafted HTTP requests containing cryptographic signatures. It executes commands remotely while suppressing access logs, leaving no forensic traces. With over 340,000 CWP instances exposed to the internet, the threat surface is substantial. First observed in June 2026 with deployment infrastructure at 136.0.141.71, the backdoor achieved zero detection rates across security vendors. A real-world victim was identified in Brazil in September 2026. The backdoor uses RSA signature verification and AES-256-CBC encryption for command and control communications through Unix domain sockets, making detection extremely difficult through conventional means.",
      "author_name": "AlienVault",
      "modified": "2026-11-05T20:37:42.853000",
      "created": "2026-11-05T15:31:01.619000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
