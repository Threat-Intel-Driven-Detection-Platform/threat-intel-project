    {
      "id": "6ae5a19f6a4b01412ddf5f9e",
      "name": "Hackers Impersonate IT Help Desk on Microsoft Teams to Hijack Active Directory Accounts and Steal Data",
      "description": "Attackers impersonated IT help desk personnel on Microsoft Teams to gain unauthorized access to Active Directory environments through social engineering and misconfigured certificate services. Two distinct intrusion campaigns leveraged Quick Assist remote support sessions after convincing users to share connection codes. Adversaries deployed portable Python, Bun, and Java runtimes to enumerate domain infrastructure and exploit vulnerable Active Directory Certificate Services configurations through ESC1 and ESC8 attack paths. In one incident, attackers obtained certificates for multiple privileged accounts and performed DCSync operations to harvest credentials. Data exfiltration was conducted using Rclone transferred to external SFTP destinations. The second intrusion used PetitPotam to coerce domain controller authentication and relay NTLM credentials to obtain unauthorized certificates. Neither attack exploited Teams vulnerabilities, but rather combined impersonation tactics, legitimate remote access tool...",
      "author_name": "AlienVault",
      "modified": "2026-11-02T23:09:19.261000",
      "created": "2026-10-31T08:06:55.059000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
