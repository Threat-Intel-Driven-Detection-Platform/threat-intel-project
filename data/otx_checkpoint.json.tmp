    {
      "id": "6aa18179c7eb1a5f0426ed7a",
      "name": "Grand Theft Auto VI hype leads to malware",
      "description": "Threat actors are exploiting anticipation for Grand Theft Auto VI by distributing malicious ISO files disguised as leaked game versions. These fake installers are spread through SEO poisoning, gaming forums, social media, and torrenting sites. The analyzed ISO contains multiple malicious components including several RAT variants (NJRAT and DCRAT), Mercurial Grabber infostealer, Chaos ransomware functioning as a wiper, and Yandex Browser. When executed, the fake installer displays Russian-language messages and deploys malware to %TEMP% folders. The package includes data exfiltration capabilities, credential theft, system control features, and destructive file encryption. Based on Russian language usage throughout the infection chain, the campaign appears to target Russian-speaking gamers. The malware components date back to 2023, suggesting repurposed tools for this opportunistic attack.",
      "author_name": "AlienVault",
      "modified": "2026-09-10T05:28:16.321000",
      "created": "2026-09-09T15:55:37.145000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
