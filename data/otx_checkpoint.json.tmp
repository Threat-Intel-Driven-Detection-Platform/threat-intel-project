    {
      "id": "6af756af3fb9352962a1bd8f",
      "name": "GeoVision Camera Software Abused to Deploy XMRig Cryptominer",
      "description": "Widespread malicious activity was observed targeting GeoVision webcam software between November 8 and November 10, affecting ten accounts and 13 organizations across various industries. Attackers exploited publicly exposed GeoVision devices to execute commands through GeoStartupAgentService.exe under SYSTEM privileges. The attack chain involved PowerShell download cradles retrieving malicious scripts from a remote server, deploying a vulnerable driver for BYOVD attacks, and configuring IFEO Debugger hijacks to disable Windows Defender components. A custom Golang loader utilizing BitTorrent DHT and PKARR resolver was deployed to maintain dynamic command and control infrastructure. The campaign ultimately delivered XMRig cryptominer to hijack computing resources. The incident highlights risks associated with internet-exposed camera management systems and demonstrates sophisticated defense evasion techniques.",
      "author_name": "AlienVault",
      "modified": "2026-11-16T10:09:36.646000",
      "created": "2026-11-13T18:27:59.718000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
