    {
      "id": "6adc07f41102c5c37a64cd50",
      "name": "Suspected DPRK Campaign staging PHP2Shell Targeting against Global PHP infrastructure",
      "description": "A Korean-speaking threat actor, tracked as the June 2026 Minjun campaign and linked with moderate confidence to North Korea's Lazarus Group, is actively planning targeted exploitation of two critical PHP vulnerabilities (CVE-2026-109618 and CVE-2026-109619) that enable unauthenticated remote code execution. The campaign prioritizes government agencies, financial institutions, manufacturing, logistics, aviation, and trading platforms across the US, Japan, Thailand, Indonesia, Korea, Australia, Taiwan, India, Singapore, UAE, Saudi Arabia, and the EU. Operators are using AI-assisted reconnaissance to rank public exploit code and plan sector-specific attacks. Exploitation attempts have been observed globally since 17 October 2026, with 17 suspected source IPs identified conducting web shell deployment and session poisoning. The vulnerabilities affect all internet-facing PHP installations below version 8.5.12, 8.4.27, 8.3.36, or 8.2.35, with Apache mod_php at highest risk.",
      "author_name": "AlienVault",
      "modified": "2026-11-23T01:03:34.136000",
      "created": "2026-10-24T01:20:52.506000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "Lazarus Group",
