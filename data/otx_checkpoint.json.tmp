    {
      "id": "6afe238e2c4ba09cd1ded286",
      "name": "agent-framework 1.26.1 and 1.26.2: PyPI credential stealer",
      "description": "Microsoft's Agent Framework meta-package on PyPI was compromised with versions 1.26.1 and 1.26.2, published on November 17, 2026. Both versions deployed a .pth startup hook that executed credential-stealing code every time Python launched, requiring no package import. The stealer harvested Azure, Azure DevOps, and GitHub Actions tokens from environment variables across 300 running processes, credential files, and cloud metadata services. It collected tokens from Azure CLI caches, pip, npm, Docker, git, and Hugging Face credentials, then minted fresh cloud tokens via Azure DevOps and GitHub Actions OIDC endpoints and Azure Instance Metadata Service. All stolen data was compressed, Base64-encoded, and exfiltrated to a webhook.site endpoint. The compromise was detected within six minutes and removed within hours, but any host running these versions should be considered fully compromised.",
      "author_name": "AlienVault",
      "modified": "2026-11-19T10:40:32.444000",
      "created": "2026-11-18T22:15:42.960000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
