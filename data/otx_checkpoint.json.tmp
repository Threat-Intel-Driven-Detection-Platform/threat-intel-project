    {
      "id": "6aff1974fdd6b0d529aa3708",
      "name": "US Bank, IRS, and Social Security Logins Stolen by a Russian-Speaking Operation",
      "description": "A Russian-speaking credential-theft operation compromised 603 Windows systems between October and November 2026, stealing US bank credentials and federal identity logins from victims' own machines. Operating from a Netherlands VPS, the attackers deployed three parallel command-and-control frameworks (HavoX, Phantom53, Kraken Bridge) and bypassed Chrome app-bound encryption, cracked LastPass, 1Password, and KeePass vaults offline, and replayed cookies to bypass Microsoft 365 MFA. At least 46 victims had ID.me or Login.gov accounts exposed, providing access to IRS, Social Security, and VA portals. The operation also targeted 35 AI developer products, 44 cryptocurrency platforms, and deployed RMM tools for persistent access. All traffic was fronted through 12 Cloudflare Workers domains. A complete exposed directory containing 1,692 operational files, including loot archives, post-exploitation scripts, and Russian-language operational logs, revealed the infrastructure and tooling used.",
      "author_name": "AlienVault",
      "modified": "2026-11-20T12:02:55.285000",
      "created": "2026-11-19T15:44:52.514000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
