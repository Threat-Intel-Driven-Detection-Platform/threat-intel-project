    {
      "id": "6ada1e572ffb7473cf202754",
      "name": "M365 Token Spray and Replay Campaign Compromises Business Email Accounts",
      "description": "Between July and September 2026, a sophisticated campaign targeted Microsoft 365 accounts through adversary-in-the-middle attacks and token replay techniques. The operation captured sign-in sessions via AiTM relays and replayed stolen tokens from IP addresses controlled by German hosting provider 1337 Services GmbH. Over ten weeks, 79 organizations were compromised with 497 successful sign-ins against over 200,000 failed attempts. Attackers registered 48 rogue Entra devices, replaced victim MFA methods, and created hidden inbox rules to conceal malicious communications. The campaign evolved through four distinct phases, rotating through different IP addresses and employing both scripted token replay and browser session replay techniques. In one case, compromised accounts were used to send payroll-related emails to external contacts, demonstrating business email compromise objectives.",
      "author_name": "AlienVault",
      "modified": "2026-11-21T14:02:03.875000",
      "created": "2026-10-22T14:31:51.661000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
      "indicators": [
