    {
      "id": "6aeeb5bc2f487ae6d84ea7e9",
      "name": "ARTEX abuse expands as cybercriminals target financial sector",
      "description": "In October 2026, the Cambodia-based threat actor Storm-3358 began leveraging the agentic AI offensive framework ARTEX to target financial organizations primarily in Southeast Asia and select global institutions. The group combines ARTEX with conventional automated tools to scan internet-connected systems, exploit vulnerabilities including anonymous file upload and server-side request forgery, and deploy open-source remote access trojans such as WISP, vshell, and AdaptixC2. ARTEX agents perform credential compromise, web shell deployment, lateral movement, privilege escalation, and data exfiltration at machine speed. This activity demonstrates an emerging trend of threat actors accelerating attack chains through agentic AI penetration testing frameworks, requiring defenders to similarly adopt AI-powered detection and response capabilities.",
      "author_name": "AlienVault",
      "modified": "2026-11-09T12:54:09.199000",
      "created": "2026-11-07T05:23:08.524000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "Storm-3358",
