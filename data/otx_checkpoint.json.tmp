    {
      "id": "6ae64194faf7dc45dce3baa3",
      "name": "VAPOR PANDA Uses AI-Driven ARTEX to Grow Global Espionage Campaign",
      "description": "VAPOR PANDA conducted a sophisticated espionage campaign beginning October 17, 2026, using the ARTEX AI-driven framework alongside DeepSeek and commercial LLMs to orchestrate parallel intrusions against over 200 organizations worldwide. Targets included foreign ministries across Latin America, Europe, Asia, and the Middle East, plus U.S.-based semiconductor, defense, pharmaceutical, nuclear, and telecommunications entities. The adversary deployed BLOODALCHEMY backdoor, conducted credential spraying, and explicitly instructed AI agents to identify systems without endpoint security sensors. This represents an escalation from single intrusions to multiple simultaneous engagements, with agents autonomously pursuing attack paths while human operators provided strategic direction in Chinese. The campaign demonstrated how threat actors combine open-source AI frameworks with commercial LLMs to dramatically scale intrusion operations beyond manual capabilities.",
      "author_name": "AlienVault",
      "modified": "2026-11-04T18:19:40.016000",
      "created": "2026-10-31T19:29:24.748000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "VAPOR PANDA",
