    {
      "id": "6a5f98b0ca49303f8f2e4aa7",
      "name": "Portugal-focused phishing campaign delivers multistage malware",
      "description": "An active Lampion malware campaign has been identified targeting Portuguese users through phishing emails that impersonate financial and administrative communications. Lampion, a Brazilian banking malware derived from the ChePro lineage, delivers initial payloads via ZIP archives containing heavily obfuscated HTML files designed to evade detection. The HTML stage retrieves additional scripts from attacker-controlled infrastructure, initiating a multistage VBS infection chain. Each stage employs extensive obfuscation techniques including junk code, encrypted strings, and dynamically generated scripts that inflate file sizes while concealing core functionality. The infection chain is deliberately fragmented across multiple independent execution stages, complicating behavioral analysis. Telemetry shows 94.6% of detections concentrated in Portugal, confirming this is a highly targeted threat focused on Portuguese-speaking victims.",
      "author_name": "AlienVault",
      "modified": "2026-07-22T08:04:45.037000",
      "created": "2026-07-21T16:05:04.177000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
