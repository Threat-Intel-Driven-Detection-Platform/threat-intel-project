    {
      "id": "6acf7922d9bc17d95d27ec5c",
      "name": "ClingSTUN Turns Vulnerable Edge Devices Into Attacker Infrastructure",
      "description": "An evolving Linux malware campaign deploys ClingSTUN, a back-connect proxy backdoor exploiting known vulnerabilities in Internet-facing IoT and network devices. The malware establishes persistent access and converts compromised systems into remotely controlled proxy nodes. Supporting multiple Linux architectures, ClingSTUN combines boot persistence, process termination, watchdog manipulation, process concealment, remote command execution, and self-propagation. It abuses legitimate public STUN infrastructure for NAT traversal. The campaign has expanded the number of vulnerabilities and device vendors it targets over time, affecting products from D-Link, EnGenius, Realtek, TP-Link, AVTECH, Ivanti, Tenda, Lantronix, and others, highlighting the continued risk posed by unpatched, unsupported, and unnecessarily exposed Internet-facing devices.",
      "author_name": "AlienVault",
      "modified": "2026-11-13T12:01:20.995000",
      "created": "2026-10-14T12:44:18.127000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
