    {
      "id": "6b042d52d8920a5e4eaa9722",
      "name": "CLoader Bot Campaign Targets Thai Organizations Through LuaJIT-Based Malware Delivery",
      "description": "A sophisticated campaign targeting organizations and individuals in Thailand has been identified, utilizing spear-phishing emails to deliver CLoader bot malware through a multi-stage infection chain. The attack begins with an obfuscated JavaScript file disguised as a PDF document using double-extension techniques. This JavaScript drops a LuaJIT executable along with an obfuscated Lua script, which serves as the malware interpreter. The payload employs multiple anti-analysis techniques including UPX packing, resource section obfuscation, and dynamic filename generation. The final payload establishes persistence through scheduled tasks and registry modifications while masquerading as legitimate Windows services. It communicates with command-and-control infrastructure via Pastebin-hosted configurations and supports remote code execution, PowerShell commands, and Windows Defender exclusion manipulation to evade detection and maintain operational capabilities.",
      "author_name": "AlienVault",
      "modified": "2026-11-23T16:53:09.880000",
      "created": "2026-11-23T12:10:58.837000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
