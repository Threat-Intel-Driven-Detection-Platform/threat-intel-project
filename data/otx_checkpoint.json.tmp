    {
      "id": "6afd28092f3aa69ab72ff6d9",
      "name": "Microsoft’s agent-framework PyPI package Compromised with Credential Stealer",
      "description": "Microsoft's agent-framework package on PyPI was compromised on November 17th, with versions 1.26.1 and 1.26.2 containing malicious code. Both versions install Python startup hooks through .pth files that silently execute on interpreter initialization. The malicious code collects Azure, GitHub Actions, and various CI/CD credentials, including environment variables, configuration files, and cloud identity tokens. It actively requests fresh Azure managed-identity and GitHub Actions OIDC tokens. The stolen data is compressed, base64-encoded, and exfiltrated to a webhook.site endpoint. The attack targets credential-related environment variables, processes, Azure and Azure DevOps credentials, GitHub Actions tokens, and configuration files from various tools including pip, npm, Docker, and Git.",
      "author_name": "AlienVault",
      "modified": "2026-11-18T07:54:49.638000",
      "created": "2026-11-18T04:22:33.857000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
