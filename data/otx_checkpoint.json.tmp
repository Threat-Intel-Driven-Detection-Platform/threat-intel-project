    {
      "id": "6afda8f9f5dd55f9f13c0cd0",
      "name": "GravityRAT Mobile Cyber-Campaign Targets Defense Personnel",
      "description": "An active cyber-surveillance campaign has been uncovered deploying GravityRAT malware against defense industry and military personnel, primarily targeting individuals from India seeking positions at foreign defense contractors. The campaign utilizes fake recruitment portals and software utility websites that mimic legitimate services to distribute malicious payloads. These sites display logos of major defense contractors like Airbus, BAE Systems, Thales, and Lockheed Martin to build credibility. GravityRAT is a multi-platform surveillance framework active since 2015, attributed to Pakistan-aligned threat actors including SpaceCobra and Cosmic Leopard. The malware conducts extensive data exfiltration including contacts, call logs, SMS messages, GPS location, documents, WhatsApp backups, and device identifiers, uploading collected information to command and control servers at regular intervals.",
      "author_name": "AlienVault",
      "modified": "2026-11-19T10:47:55.541000",
      "created": "2026-11-18T13:32:41.172000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "SpaceCobra, Cosmic Leopard, Operation Celestial Force",
