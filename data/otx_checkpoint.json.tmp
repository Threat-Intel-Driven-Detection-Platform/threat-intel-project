    {
      "id": "6af327a10b5317aadf0fbfc8",
      "name": "Dark Web Profile: CyberXero",
      "description": "CyberXero is a Russian-speaking, financially motivated Initial Access Broker operating on Dark Web forums, conducting two parallel operations: a global mass-exploitation campaign targeting WordPress, Magento and e-commerce platforms, and a directed campaign focused on Ukrainian energy and utilities organizations. The actor distinguishes itself through AI augmentation, deploying 51 specialized Claude Code agents and PentAGI integrated with Cobalt Strike. Active since July 2026, CyberXero generates revenue through access brokering, payment data theft, and cryptocurrency payments. Over 40 organizations across Ukraine, Poland, China, Pakistan and the Netherlands have been affected, with more than 628,000 personal records exfiltrated and 429 WordPress administration panels compromised. The actor weaponizes vulnerabilities within 30 days and employs sophisticated techniques including SQL injection, PHP deserialization, and lateral movement tactics.",
      "author_name": "AlienVault",
      "modified": "2026-11-11T09:29:49.719000",
      "created": "2026-11-10T14:18:09.950000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "CyberXero",
