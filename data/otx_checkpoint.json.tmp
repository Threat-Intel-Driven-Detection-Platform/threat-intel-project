    {
      "id": "6ad71c12c5136d952c0cda96",
      "name": "CVE-2026-102764: Critical BeyondTrust Remote Support Authentication Bypass Exploited in the Wild",
      "description": "A critical authentication bypass vulnerability in BeyondTrust Remote Support platform allows unauthenticated remote attackers to perform file operations without user interaction. Versions 26.2.3 and earlier are affected. BeyondTrust confirmed exploitation in the wild with two compromises dating to August 29, 2026, affecting one hosted instance and one self-hosted appliance. Mandiant investigation revealed arbitrary file uploads, deployment of SAWFLY web shell and BARECLAW tunneler, root escalation, credential-vault extraction attempts, persistence mechanisms, and log deletion. The activity is attributed to ARMORY CASTLE, a suspected PRC-nexus espionage actor. CISA added this vulnerability to the Known Exploited Vulnerabilities list on October 16, 2026. Organizations must apply emergency patches and investigate for compromise, as patching does not remove persistence.",
      "author_name": "AlienVault",
      "modified": "2026-10-20T14:35:24.970000",
      "created": "2026-10-20T07:45:22.096000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "ARMORY CASTLE",
