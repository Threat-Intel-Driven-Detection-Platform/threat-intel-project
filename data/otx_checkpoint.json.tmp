    {
      "id": "6ad99ec5dea46c1b74460546",
      "name": "LiteLLM supply chain compromise",
      "description": "On October 21, 2026, attackers compromised litellm version 1.107.0, a popular Python proxy library for LLM providers with approximately 23 million weekly downloads. The malicious release was available on PyPI and official Docker images for about two hours. Attackers used stolen GitHub CLI OAuth tokens from three engineers to launch a private release workflow against a malicious fork. The payload installed a credential stealer targeting cloud, developer, AI-tool, browser and LiteLLM proxy credentials, plus a second-stage remote access trojan backdoor. The malware executes automatically whenever Python starts through dropped files in the site-packages directory. This represents the second supply chain compromise of LiteLLM in 2026, with no established connection to the previous incident linked to TeamPCP activity.",
      "author_name": "AlienVault",
      "modified": "2026-10-22T06:52:45.904000",
      "created": "2026-10-22T05:27:33.334000",
      "revision": 2,
      "tlp": "white",
