    {
      "id": "6af7d96cec6d5f884d3b30bc",
      "name": "Attackers use Crypto Exchange Names to Disguise Unauthorized Sessions on 100+ ScreenConnect Servers",
      "description": "Between November 3 and November 13, 2026, threat actors enrolled over 2,200 fake guest sessions across 118 ScreenConnect servers belonging to 109 MSPs and organizations. The unauthorized sessions masquerade as legitimate computers using crypto exchange-themed names like KUCOIN-SRV and BACKUP-PROBIT, displaying screenshots of trading desktops. The majority of connections originated from a single IONOS-hosted IP address. While no malicious activity has been directly observed, investigators suspect these sessions serve as bait to exploit CVE-2026-84869, a critical ScreenConnect vulnerability that could allow malicious guests to execute files on unpatched technician workstations with elevated privileges. The sessions maintain persistent connections every 151 seconds to appear online, potentially waiting for technicians to connect and expose their systems to exploitation.",
      "author_name": "AlienVault",
      "modified": "2026-11-16T10:12:19.414000",
      "created": "2026-11-14T03:45:48.397000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
