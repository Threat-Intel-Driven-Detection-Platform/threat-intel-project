    {
      "id": "6ae5f5fe1e9d5fb8fd713f1a",
      "name": "Appraisal by AI: Model-driven victim prioritization in the VOLTA infostealer",
      "description": "VOLTA is a sophisticated Windows infostealer that incorporates AI-powered victim profiling to prioritize targets based on monetization potential. After harvesting credentials, browser data, cryptocurrency wallets, sessions from various platforms, and personal information, it compiles a structured evidence bundle and submits it to OpenRouter using LLM models like Claude Opus, with fallback options to Kimi-K2 and Gemini. The LLM acts as a forensic intelligence analyst, ranking stolen assets by value and assessing victim security posture. VOLTA performs live enrichment by accessing victim Gmail, Uber Eats, DoorDash, Discord, and Roblox accounts using stolen tokens. The malware self-deletes and operates through third-party infrastructure without actor-owned servers, suggesting a builder-based distribution model where customers can deploy customized versions.",
      "author_name": "AlienVault",
      "modified": "2026-11-02T23:12:18.261000",
      "created": "2026-10-31T14:06:54.711000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
