    {
      "id": "6ae4664dc4882837d4aa5670",
      "name": "Kairos Hold'em: Dissecting a New Go-Based DDoS Botnet",
      "description": "Kairos is a newly documented DDoS botnet for Linux written in Go, designed to transform compromised machines into attack nodes. The bot establishes hundreds to thousands of TCP connections to operator-specified targets, maintaining them with minimal keepalive bytes every few seconds to exhaust victim services. Initial access occurs via Telnet using default root credentials with empty passwords. The payload is delivered through multi-fallback shell commands via HTTP from the same server used for command and control. The bot operates with a simple three-command protocol including hold, kill all, and kill unpause commands. It masquerades as a kernel worker thread and employs a build-per-C2 distribution model, with samples identified across multiple CPU architectures including x86_64, ARM, MIPS, and 386.",
      "author_name": "AlienVault",
      "modified": "2026-10-30T09:57:27.499000",
      "created": "2026-10-30T09:41:33.567000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
