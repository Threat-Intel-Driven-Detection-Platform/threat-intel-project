          "id": 4370489903,
          "indicator": "shivlpf.shop",
          "type": "domain",
          "created": "2026-10-02T01:47:28",
          "content": "",
          "title": "",
          "description": "",
          "expiration": null,
          "is_active": 1,
          "role": null
        }
      ],
      "tags": [
