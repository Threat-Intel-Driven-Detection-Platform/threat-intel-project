    {
      "id": "6af5e2140542eb6793155aa6",
      "name": "Crafty Microsoft Teams Booking Flow Disguises Device Code Phishing",
      "description": "A sophisticated device code phishing campaign was observed in mid-October targeting the construction industry. Attackers used a typosquatted domain and impersonated a senior vice president to deliver spear-phishing emails containing multi-stage redirects. The campaign featured a fake Microsoft Teams meeting scheduler that disguised the device code authorization process within a booking workflow. When victims clicked through the booking interface, the site secretly initiated a Microsoft device-code sign-in and copied the generated code to the clipboard. The final step directed targets to Microsoft's legitimate device-login page to complete authorization. The encrypted phishing kit included fallbacks for MFA and used residential proxies to route traffic, making detection more challenging.",
      "author_name": "AlienVault",
      "modified": "2026-11-12T16:40:03.938000",
      "created": "2026-11-12T15:58:12.622000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
