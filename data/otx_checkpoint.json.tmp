    {
      "id": "6ae0cd70485894a6eeb2bad8",
      "name": "Automated Subversion and Attempted Takeover of AI Pentesting Harnesses",
      "description": "Unprotected Cairn AI intrusion harnesses are being systematically compromised by unknown actors through automated campaigns that began around October 20, 2026. Attackers insert malicious tasks that manipulate agents to compromise the host systems, involving profiling installations, stealing secrets including AI model API keys, downloading Poseidon malware, and installing unauthorized SSH keys. Two distinct threat clusters, designated AIA0009 and AIA0010, conduct synchronized waves of attacks across multiple panels. AIA0009 focuses on persistence and malware deployment, while AIA0010 emphasizes exploration and credential extraction. The campaigns appear highly automated and possibly agentic, utilizing AI to attack AI operations. Activities include container escape attempts, reconnaissance of host environments, and deployment of Poseidon RAT configured with Bunny.net CDN command and control infrastructure.",
      "author_name": "AlienVault",
      "modified": "2026-10-27T23:33:40.100000",
      "created": "2026-10-27T16:12:32.060000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
