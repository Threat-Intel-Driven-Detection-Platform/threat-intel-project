    {
      "id": "6af5767f02f93b7da4d25b8a",
      "name": "The Rise of LLMjacking: How Attackers Monetize Compromised Cloud and Model Resources",
      "description": "Google Threat Intelligence Group identified multiple incidents where attackers hijacked enterprise Large Language Model (LLM) access in a tactic called LLMJacking. These intrusions affected organizations across financial services, retail, technology, and transportation sectors in North America, South America, and Asia Pacific. Unlike cryptojacking's gradual resource consumption, LLMJacking can generate fraudulent cloud charges exceeding $100,000 per day within hours, with cumulative bills reaching $1 million before access revocation. Attackers obtain initial access through exposed cloud credentials, API keys, and service account tokens, then escalate privileges and deploy proxy infrastructure to resell stolen compute capacity through underground marketplaces operated by LLM Mixers, who aggregate and redistribute unauthorized model access to subscribers.",
      "author_name": "AlienVault",
      "modified": "2026-11-12T09:53:17.532000",
      "created": "2026-11-12T08:19:11.046000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "UNC6993",
      "indicators": [
