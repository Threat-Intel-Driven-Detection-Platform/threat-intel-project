    {
      "id": "6adb52fde8bfb072942ad917",
      "name": "VeloCloud Orchestrator SQL Injection Vulnerability",
      "description": "VeloCloud Orchestrator (VCO) on-premises versions contain a critical SQL injection vulnerability that allows authenticated users with minimal privileges to escalate to superuser operator access. Any user with Enterprise Read Only role can exploit this flaw to access privileged internal functionality, potentially compromising the confidentiality, integrity, and availability of the orchestrator and managed data. The vulnerability is actively exploited, with specific malicious IP addresses identified. Affected versions include VCO 5.2.x prior to 5.2.3.18, 6.1.x prior to 6.1.3.10, and 6.4.x prior to 6.4.2.12. Hosted and dedicated VCO instances were already patched. Immediate upgrade to fixed releases is recommended, along with restricting web interface access and monitoring for suspicious activity.",
      "author_name": "AlienVault",
      "modified": "2026-11-22T12:01:14.576000",
      "created": "2026-10-23T12:28:45.765000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
      "indicators": [
