    {
      "id": "6aaa8c12baf8c0157f30d354",
      "name": "NightEagle targets Russian companies",
      "description": "The NightEagle APT group (APT-Q-95), active since 2023 and initially targeting Asian organizations, has expanded operations to Russian enterprises. Attackers gain initial access through compromised VPN credentials originating from Cloudflare WARP tunnels and European infrastructure providers. They deploy the GhostContainer backdoor on Microsoft Exchange servers, exploiting CVE-2020-0688 and incorporating components from Neo-reGeorg and ysoserial. For traffic tunneling, the group uses Microsoft Dev Tunnels combined with rdp2tcp, masking malicious tools as legitimate software hosted on GitHub repositories. They exploit vulnerabilities including CVE-2019-0708 (BlueKeep) for lateral movement and perform DCSync attacks against Active Directory to compromise domain controllers. The group employs sophisticated techniques for persistence and privilege escalation across corporate networks.",
      "author_name": "AlienVault",
      "modified": "2026-09-16T13:05:32.065000",
      "created": "2026-09-16T12:31:14.062000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "NightEagle",
      "indicators": [
