    {
      "id": "6ada5f20aaf6e87709a6dee5",
      "name": "Beyond the Sandbox: Leveraging Android Intrusion Logs to Expose Advanced Threats",
      "description": "Advanced Android threats increasingly operate beyond the standard application sandbox, requiring multi-layered detection strategies that combine on-device behavioral analysis with OS-level telemetry. Android's Delegated Scope enables enterprises to grant security applications access to security and network logs on managed devices without full MDM authority. The new Intrusion Logging feature extends similar forensic visibility to BYOD users through Advanced Protection on supported devices running Android 16 or later. This privacy-preserving capability allows users to collect and share encrypted security, DNS, and connection logs for analysis. The technical analysis demonstrates how these logs expose the complete RatHat attack chain, including Wireless Debugging self-pairing, ADB shell command execution, daemon staging, and command-and-control communications, providing actionable indicators of compromise across process execution, privileged operations, and network activity.",
      "author_name": "AlienVault",
      "modified": "2026-10-23T12:19:07.461000",
      "created": "2026-10-22T19:08:16.738000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
