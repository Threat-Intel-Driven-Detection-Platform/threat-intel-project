    {
      "id": "6a8734bac622f3c7b2d9a633",
      "name": "Distinct Clusters Target Individuals of Interest to Russia",
      "description": "Three distinct suspected Russian cyber espionage threat clusters—UNC6293, UNC7005, and UNC5976—are abusing legitimate authentication flows to target individuals in academia, aerospace, defense, governments, and think tanks across Europe and the United States. These groups conduct sophisticated phishing campaigns using app password phishing, OAuth phishing, device code phishing, and malware deployment. UNC6293 and UNC7005 are assessed with moderate confidence to be initial access clusters linked to ICE RELIC (formerly APT29), while UNC5976 appears distinct. Operations leverage social engineering through fake diplomatic invitations, conference registrations, and file sharing pages. UNC7005 was tied to hospitality captive portal redirects and deployed MaaS infostealers including VIDAR and ATOMIC. These actors abuse legitimate authentication mechanisms including Google OAuth, Microsoft device codes, and WhatsApp device linking to compromise personal accounts, making detection challenging for organizations.",
      "author_name": "AlienVault",
      "modified": "2026-08-20T23:19:15.402000",
      "created": "2026-08-20T17:09:14.994000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "APT29",
