    {
      "id": "6ac741ed2968234538d416fa",
      "name": "RMM Tools Being Distributed Through Phishing Attacks (ScreenConnect, FleetDeck, Datto, SimpleHelp, JumpCloud, N-able)",
      "description": "Multiple Remote Monitoring and Management (RMM) tools are being distributed through phishing campaigns involving video files and email attachments. Threat actors exploit legitimate RMM solutions like ScreenConnect, FleetDeck, Datto, SimpleHelp, JumpCloud, and N-able to gain remote access to compromised systems while evading security detection. These tools, typically used for legitimate IT administration purposes, are weaponized through various delivery methods including LNK files, BAT scripts, VBS files, and PDF documents disguised as business documents. The campaigns leverage social engineering tactics, presenting fake Adobe Acrobat updates, DocuSign viewers, and document access prompts to trick victims into installing these remote access tools. Each RMM tool contains configuration data linking back to attacker infrastructure, including deployment IDs, account identifiers, and command-and-control server addresses embedded within installation files.",
      "author_name": "AlienVault",
      "modified": "2026-11-07T07:02:31.206000",
      "created": "2026-10-08T07:10:37.804000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "Scattered Spider",
