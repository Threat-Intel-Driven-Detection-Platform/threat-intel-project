    {
      "id": "6afc61c46fe947aa765b59ec",
      "name": "Threat Researcher’s Notebook: BubbleLoader",
      "description": "BubbleLoader is an evolving loader actively used in recent attack campaigns to deliver secondary malicious payloads. It hijacks common benign software such as WinRAR, x64dbg, Windows Media Player, Firefox Launcher, and virtiofs by patching entry points and adding two PNG files that serve as delivery mechanisms. The loader operates in four stages: the entry point patch allocates memory and copies PNGs, a fake PNG houses shellcode and XOR-encrypted third stage, shellcode decrypts the third stage using the first PNG as a rolling XOR key, and the third stage performs reflective loading with anti-analysis features. BubbleLoader leverages runtime polymorphism to change in-memory payload hashes for every execution, complicating forensic analysis. Two activity clusters observed in mid-September and early October indicate active deployment by adversaries.",
      "author_name": "AlienVault",
      "modified": "2026-11-18T07:42:40.212000",
      "created": "2026-11-17T14:16:36.683000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
