    {
      "id": "6ab561550075cd5f0b500b25",
      "name": "The Not So Silent Miner: Threat Actor Compiles Cryptominer on the Endpoint",
      "description": "A threat actor exploited a Samsung MagicINFO vulnerability (CVE-2025-4632) to gain initial access to victim endpoints. After three attempts, they successfully deployed a rogue AnyDesk instance using various download methods including certutil and PowerShell. The actor created a new local administrator account named 'oldadministrator' and disabled Microsoft Defender protections. Uniquely, instead of dropping a pre-compiled cryptominer, the threat actor compiled one directly on the compromised endpoint using Silent XMR Miner Builder.exe, executing multiple .NET Framework utilities and C compilers including donut.exe, tcc.exe, and MinGW64 tools. The resulting Monero cryptominer connected to the C3Pool mining service and ran under explorer.exe with suspicious command-line arguments. This compilation approach generated significant EDR telemetry, making the activity ironically conspicuous despite using tools associated with silent deployment.",
      "author_name": "AlienVault",
      "modified": "2026-10-24T17:03:36.233000",
      "created": "2026-09-24T17:43:49.126000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
      "indicators": [
