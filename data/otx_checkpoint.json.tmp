    {
      "id": "6ab68af3aecfcfc39b2824d8",
      "name": "The Psychedelic Stealer: When a CAPTCHA Becomes an Installer",
      "description": "Arctic Wolf Labs is tracking an ongoing campaign that compromises legitimate Ukrainian business websites and uses injected iframes to display a Ukrainian-language fake Cloudflare verification page. When a visitor interacts with the page, the lure copies a Windows Installer command to the clipboard and instructs the visitor to paste it into the Windows Run dialog. The command retrieves an MSI package that ultimately delivers a previously unidentified infostealer containing the embedded tag “Psychedelic.”",
      "author_name": "AlienVault",
      "modified": "2026-10-25T14:00:43.001000",
      "created": "2026-09-25T14:53:38.389000",
      "revision": 1,
      "tlp": "white",
      "public": 1,
      "adversary": "",
      "indicators": [
        {
          "id": 4493685255,
          "indicator": "CVE-2026-85102",
          "type": "CVE",
          "created": "2026-09-25T14:53:40",
