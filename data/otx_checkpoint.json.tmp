        {
          "id": 4606464222,
          "indicator": "84b2b8d7435a5dfc876fbd9b635a6049dc3f1f2a",
          "type": "YARA",
          "created": "2026-11-23T17:19:04",
          "content": "rule vmcloudoor\n{\n    meta:\n        author = \"Heurs\"\n        description = \"vmcloudoor / oss_v2 helper: Linux x64 backdoor posing as Aliyun/Tencent/Huawei host agent\"\n        sample_hash = \"0e1bd634d5fc8f4df1c91f0072a4556eb11f41ecc95b05f5a2ffb0e0b914613d\"\n        date = \"2026-10-30\"\n        source =  \"Exatrack\"\n        tlp =  \"CLEAR\"\n    strings:\n        $ns1  = \"N6oss_v213OssPullSourceE\" ascii\n        $ns2  = \"N6oss_v216HttpGiteeFetcherE\" ascii\n        $core = \"hpgoc2.oss.v2.core\" ascii\n        $memfd = \"ov2-out\" ascii\n        $tmp1 = \"%s.ov2_%s_XXXXXX\" ascii\n        $tmp2 = \"%s.ov2_%d_%s_XXXXXX\" ascii\n        $s802 = \"unsupported task type in S8-02\" ascii\n        $gitee = \"https://gitee.com/watch_dog_auth/plus/raw/master/config\" ascii\n        $ua   = \"AliyunSysAssist/1.0\" ascii\n        $p1   = \"YunJingSysAssist\" ascii\n        $p2   = \"UniAgentSys\" ascii\n        $p3   = \"kworker/0:2H\" ascii\n        $shm  = \"/dev/shm/.ov2/\" ascii\n    condition:\n        uint32(0) == 0x464c457f and filesize < 3MB and\n        ( ($ns1 and $ns2) or $s802 or ($core and $gitee) ) and\n        4 of them\n}",
          "title": "vmcloudoor",
          "description": "vmcloudoor / oss_v2 helper: Linux x64 backdoor posing as Aliyun/Tencent/Huawei host agent",
          "expiration": null,
          "is_active": 1,
          "role": null
        }
