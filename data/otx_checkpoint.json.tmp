    {
      "id": "6ad9eb3e5a8fa9121e8ab038",
      "name": "Amazon Threat Intelligence identifies PHP2Shell exploitation prior to public disclosure in MadPot",
      "description": "Amazon Threat Intelligence discovered PHP2Shell exploitation attempts in MadPot honeypot telemetry on October 17, 2026, four days before the public disclosure of CVE-2026-109618 and CVE-2026-109619. The initial exploit originated from a commercial anonymization network, suggesting threat actor involvement during the embargo period. Multiple proof-of-concept exploits emerged on the disclosure date, with varied payloads and infrastructure indicating multiple actors. Following the embargo lift on October 21, 2026, exploitation became widespread within hours. This incident highlights two critical lessons: coordinated disclosure cannot guarantee zero-day protection, and AI-assisted analysis has dramatically shortened the time from patch release to working exploits, requiring organizations to measure patch timelines in hours rather than days.",
      "author_name": "AlienVault",
      "modified": "2026-10-28T21:19:53.514000",
      "created": "2026-10-22T10:53:50.824000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
      "indicators": [
