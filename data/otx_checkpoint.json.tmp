    {
      "id": "6ac614ca291abbad48bc40de",
      "name": "Akira Ransomware Attack Investigation",
      "description": "In September, an organization experienced an Akira ransomware attack, with investigation revealing the threat actor's tactics and tools. The attacker gained access through Remote Desktop Protocol, subsequently disabling antivirus protections on the compromised endpoint. The adversary deployed Rclone for data exfiltration purposes and utilized a GOST tunneling tool to maintain persistence within the network. Following these preparatory activities, the ransomware payload was executed. Forensic analysis of the impacted endpoints enabled investigators to identify key indicators of compromise, including command and control infrastructure and malicious executables. The investigation uncovered specific file paths and SHA256 hashes associated with the ransomware binary and GOST tunnel executable, along with the C2 server IP address used for tunnel communications.",
      "author_name": "AlienVault",
      "modified": "2026-11-06T09:12:54.824000",
      "created": "2026-10-07T09:45:46.956000",
      "revision": 3,
      "tlp": "white",
      "public": 1,
      "adversary": "Akira",
      "indicators": [
