    {
      "id": "6afb2c6589ab78953b54db22",
      "name": "Fake Prime Gaming x FC 27 reward site harvests EA passwords and 2FA codes",
      "description": "Football fans seeking free player packs for EA SPORTS FC 27 are targeted by a sophisticated phishing campaign mimicking Prime Gaming reward pages. The fake site, styled as an official promotion, directs victims to a fraudulent EA sign-in page that captures email addresses, passwords, and two-factor authentication codes. The stolen credentials are sent to attacker-controlled servers that validate entries before proceeding, potentially allowing immediate account takeover. The phishing kit includes tracking capabilities for social media traffic sources and masquerades as an internal authentication tool. Compromised EA accounts may contain valuable virtual assets, purchased games, and payment information. The operation demonstrates advanced credential harvesting techniques specifically targeting the gaming community following FC 27's September launch.",
      "author_name": "AlienVault",
      "modified": "2026-11-17T10:40:13.383000",
      "created": "2026-11-16T16:16:37.370000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
