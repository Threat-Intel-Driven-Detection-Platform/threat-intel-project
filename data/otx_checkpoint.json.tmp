    {
      "id": "6aeddff8a8cf552b829954c3",
      "name": "Armorsteal Unpacked: Breaking Down a Python Malware Kit That Steals Data and Mines Crypto",
      "description": "Armorsteal is a sophisticated Python-based malware kit that combines information stealing, cryptocurrency mining, and backdoor capabilities. Distributed through fake download pages for legitimate tools, it installs into C:\\Windows\\SystemHealth\\Update with three scheduled tasks maintaining persistence. The malware uses PyArmor obfuscation and includes sandbox evasion by checking for cloud providers. Its modular architecture features a controller (SysMon.py) that functions as a backdoor accepting only RSA-signed code, a miner manager (xm_handler.py) running XMRig while detecting and evading monitoring tools, a spy module logging keystrokes and swapping clipboard cryptocurrency addresses, and a comprehensive stealer targeting browser credentials, Discord tokens, cryptocurrency wallets, seed phrases, and password manager vaults. The kit employs 11 failover C2 domains and adds Windows Defender exclusions to avoid detection.",
      "author_name": "AlienVault",
      "modified": "2026-11-06T19:10:54.774000",
      "created": "2026-11-06T14:11:04.969000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
