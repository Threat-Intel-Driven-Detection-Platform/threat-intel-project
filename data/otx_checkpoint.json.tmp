    {
      "id": "6a8478fe441f9c15e06ee4cc",
      "name": "Signed Overwolf Binary Sideloads ValleyRAT Malware in India",
      "description": "A phishing campaign targets Indian organizations by impersonating the Indian Income Tax Department. Victims receive emails containing links to spoofed notice pages that download ZIP archives. These archives include a legitimately signed Overwolf executable and two hidden files: a malicious DLL and an encrypted binary. When executed, the signed binary side-loads the malicious DLL through DLL hijacking. The DLL is UPX-packed and modified with Astral-PE, and decrypts the binary file containing ValleyRAT. The payload uses modified RC4 encryption with a 115-byte key and deploys entirely in memory. Once active, ValleyRAT establishes persistence through scheduled tasks masquerading as OneDrive entries, marks dropped files as hidden and system files, and performs process hollowing into svchost.exe to evade detection before connecting to command and control infrastructure.",
      "author_name": "AlienVault",
      "modified": "2026-09-17T15:11:37.216000",
      "created": "2026-08-18T15:23:42.261000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
