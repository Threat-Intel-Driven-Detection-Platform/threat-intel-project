    {
      "id": "6af1ef590698ce92eade8614",
      "name": "Analyzing an Illegal Android Gambling App Built with Flutter",
      "description": "A Flutter-based Android malware campaign distributes an illegal online gambling application disguised as a Macau casino clone. The malware employs a sophisticated multi-tiered infrastructure with configuration servers, registration servers, and game servers. Victims engage in rigged casino games where mathematical odds favor cybercriminals, while the platform exploits gambling addiction through VIP recharges and referral schemes. The application exfiltrates sensitive data including geolocation coordinates, phone numbers, and device information through encrypted channels using AES encryption and HMAC-SHA256 authentication. Communication flows through multiple server tiers, with fallback mechanisms ensuring persistent connectivity. The malware represents professional-grade development with clean REST APIs and comprehensive backend ecosystem, though improved reverse engineering tools in 2026 have made analysis more feasible compared to 2024.",
      "author_name": "AlienVault",
      "modified": "2026-11-10T09:31:45.310000",
      "created": "2026-11-09T16:05:45.384000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
