    {
      "id": "6af1d860f5d71db2f5f24f0e",
      "name": "Infostealer VOLTA That Has AI Assess Stolen Information",
      "description": "VOLTA is a Windows-based infostealer that incorporates an LLM assessment phase to evaluate stolen data. It operates through multiple phases: stealing credentials, sessions, and cryptocurrency wallets from browsers and applications; enriching data by querying external services with stolen tokens; sending bundled information to LLMs via OpenRouter to assess victim monetization value; and exfiltrating data through Telegram. The malware employs sophisticated techniques including Chrome App-Bound Encryption bypass, BIP-39 seed phrase validation, and automatic model switching when encountering refusals. Only one sample has been observed, submitted to VirusTotal in October 2026, with no confirmed in-the-wild usage.",
      "author_name": "AlienVault",
      "modified": "2026-11-10T09:39:08.903000",
      "created": "2026-11-09T14:27:44.949000",
      "revision": 2,
      "tlp": "white",
