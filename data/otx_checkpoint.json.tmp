    {
      "id": "6ac6bb9b4a8df7d9c471fc83",
      "name": "Inside PhantomPolia: Remus Stealer Delivery via Donut Shellcode in ClickFix Campaign",
      "description": "LevelBlue observed a ClickFix campaign delivering Remus Stealer through compromised websites using PhantomPolia, a JavaScript loader that retrieves encrypted configurations from Ethereum Sepolia smart contracts via public RPC endpoints. The loader decrypts configurations locally using PBKDF2 and AES-GCM to obtain C2 domains. Victims are tricked into executing PowerShell commands that retrieve and decrypt additional configurations using AES-CBC before downloading bundled installers containing AutoIt executables. The AutoIt script decrypts embedded Donut-packed shellcode and executes it from allocated memory, ultimately loading Remus Stealer. This information-stealing malware collects system data, credentials, browser information, password managers, and cryptocurrency wallets. Stolen data is compressed using custom methods and encrypted with ChaCha20 before exfiltration to attacker-controlled servers.",
      "author_name": "AlienVault",
      "modified": "2026-10-08T08:02:28.795000",
      "created": "2026-10-07T21:37:31.078000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
