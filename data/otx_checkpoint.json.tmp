    {
      "id": "6acf82f3a84bcf5248537bf9",
      "name": "Case of AgentTesla Malware Distribution Disguised as a Business Proposal Email",
      "description": "A phishing campaign has been observed distributing AgentTesla infostealer through emails masquerading as business proposal requests. Recipients are asked to review an attached product list, but the ZIP file contains an executable file instead of a document. The malicious EXE disguises itself as a café management program using Chinese-language descriptions and UI elements. Through multiple stages of obfuscation, the malware extracts encrypted data from bitmap resources, performs XOR decryption, and loads successive .NET payloads into memory. The final payload is AgentTesla, which steals credentials, cookies, and contact information from browsers, email clients, FTP and VPN applications. Stolen data is exfiltrated via FTP to a compromised server. The attack demonstrates sophisticated multi-stage loading techniques and social engineering tactics targeting business users.",
      "author_name": "AlienVault",
      "modified": "2026-10-14T13:43:49.796000",
      "created": "2026-10-14T13:26:11.771000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
      "indicators": [
