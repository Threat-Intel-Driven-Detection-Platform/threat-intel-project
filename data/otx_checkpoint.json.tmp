    {
      "id": "6ada6051fb91aa7551af4ba6",
      "name": "SEO Poisoning Campaign Delivers New Armorsteal Malware",
      "description": "In September 2026, an SEO poisoning campaign distributed Armorsteal malware through fake websites impersonating Chocolatey package manager and Microsoft Activation Scripts (MAS) tool. Victims searching for software installation commands were presented with malicious PowerShell scripts that deployed Python-based malware protected by Pyarmor. The malware consists of three main components: a remote access module that communicates with command-and-control servers and verifies RSA-2048 signatures on received tasks; a surveillance module that logs keystrokes, monitors clipboard activity, hijacks cryptocurrency wallet addresses, and captures screenshots; and an information stealer targeting browser data, Discord tokens, cryptocurrency wallets, seed phrases, passwords, and SSH keys. The campaign employed anti-analysis techniques including cloud provider detection and code obfuscation, with infrastructure changes observed throughout the monitoring period.",
      "author_name": "AlienVault",
      "modified": "2026-11-21T19:00:26.421000",
      "created": "2026-10-22T19:13:21.613000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
