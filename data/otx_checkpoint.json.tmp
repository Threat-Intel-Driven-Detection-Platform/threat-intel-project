    {
      "id": "6b00423946b48f044785f9d8",
      "name": "Device Code Phishing in Microsoft 365: Attack Analysis",
      "description": "In November 2026, a resurgence of device-code phishing campaigns targeted Microsoft 365 accounts using payment-themed emails and fake SharePoint workspaces. Attackers delivered obfuscated HTML and SVG attachments that redirected victims through verification gates to counterfeit document-sharing pages. These lures instructed recipients to enter attacker-supplied codes into genuine Microsoft authorization pages, exploiting the device-code authentication flow. When victims completed authentication, including MFA, attacker-controlled clients received access tokens with granted permissions. The campaigns employed sophisticated obfuscation techniques including fragment reversal, Base64 substitution, and XOR encoding. Session-status checks and heartbeat mechanisms coordinated the phishing pages with backend infrastructure. The attacks combined legitimate business correspondence pretexts with Microsoft's authentic sign-in infrastructure to deceive users into authorizing malicious access requests.",
      "author_name": "AlienVault",
      "modified": "2026-11-20T12:53:20.814000",
      "created": "2026-11-20T12:51:05.323000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
