    {
      "id": "6af6dd7f5c46ed2857e7d678",
      "name": "Stolen webcam clips of 900+ victims feed North Korea's $400 million fake Zoom scheme",
      "description": "North Korean state-sponsored hackers have stolen over $400 million in cryptocurrency during the past 18 months through a sophisticated social engineering operation known as FaceStealer. The attackers compromise legitimate accounts on platforms like Telegram, LinkedIn, Slack, and Discord to invite targets to fake Zoom or Teams meetings. These fraudulent calls display stolen webcam footage of previous victims, creating the illusion of legitimate participants. During the calls, attackers claim audio issues and instruct victims to run malicious scripts that install cookie harvesters, keyloggers, screen capturers, and backdoors. Each successful attack records new victims whose footage is then used in subsequent operations. The scheme primarily targets cryptocurrency wallet holders, web3 workers, and open-source maintainers, with hackers sometimes waiting months or over a year before stealing cryptocurrency funds.",
      "author_name": "AlienVault",
      "modified": "2026-11-13T10:14:28.009000",
      "created": "2026-11-13T09:50:55.466000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "Lazarus Group",
      "indicators": [
        {
          "id": 4187584217,
          "indicator": "uu01webzoom.us",
          "type": "domain",
          "created": "2026-11-13T09:50:56",
          "content": "",
          "title": "",
          "description": "",
          "expiration": null,
          "is_active": 1,
          "role": null
        }
      ],
