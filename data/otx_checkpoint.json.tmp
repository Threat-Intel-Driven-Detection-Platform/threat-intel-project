    {
      "id": "6afc6f463588da4e08ab1204",
      "name": "AI Agents Targeted Through Malicious GitHub Repositories",
      "description": "A sophisticated malware campaign has been discovered that targets developers using AI coding assistants through compromised GitHub repositories. The attack exploits configuration files and instruction documents that AI agents use to understand projects, such as AGENTS.md and CLAUDE.md. Twenty-two malicious repositories have been identified containing a concealed payload (setup.js) that steals credentials from platforms including GitHub, GitLab, AWS, Azure, and Google Cloud. The malware validates stolen tokens, modifies repositories, infects software packages, and propagates by injecting malicious instructions into AI-agent configuration files. It can also spread through victim accounts by committing malicious files to repositories with sufficient permissions, affecting npm, PyPI, RubyGems, and JFrog package ecosystems.",
      "author_name": "AlienVault",
      "modified": "2026-11-18T07:51:18.511000",
      "created": "2026-11-17T15:14:14.316000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
