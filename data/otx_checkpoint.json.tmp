    {
      "id": "6ad81ada1b040cdb328c726b",
      "name": "From Phishing to LLMjacking: Threat Actors Targeting Cloud Billing Accounts for LLM Usage",
      "description": "Threat actors are conducting sophisticated campaigns targeting Google Cloud Platform environments through phishing attacks via sponsored search ads. Attackers compromise privileged user credentials using fake login pages, then manipulate organizational policies to disable security guardrails. They create service accounts with Gemini API access, invite external attacker-controlled accounts, and assign administrative billing roles. The attackers link their external GCP projects to victim billing accounts, enabling them to execute large-scale AI workloads while hiding activity from victim monitoring. This results in unauthorized charges reaching tens to hundreds of thousands of dollars within 24-48 hours. The campaigns employ evasion techniques including geographic IP blending and demoting legitimate administrators to prevent detection and remediation.",
      "author_name": "AlienVault",
      "modified": "2026-11-20T01:03:39.253000",
      "created": "2026-10-21T01:52:26.319000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
