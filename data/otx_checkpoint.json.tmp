    {
      "id": "6afea0670379624593667583",
      "name": "Fake Conad Plus App: A Promise of 10× Loyalty Points Conceals Android Malware",
      "description": "A fraudulent campaign targeting users in Italy impersonates Conad, a retail brand, by offering multiplied miPREMIO loyalty points through a fake application called Conad Plus. The malicious website conad-plus[.]shop distributes an Android malware family identified as Koktevrat. The installation chain involves two APK files with RC4-encrypted assets containing operational code. Once installed and granted Accessibility permissions, the remote access trojan can capture screenshots, intercept keystrokes, collect form data, enumerate installed applications, display overlay screens, and execute interface interactions. Commands are received via WebSocket connection to a static command-and-control server, supplemented by Firebase Cloud Messaging for signaling. The malware employs a domain generation algorithm for fallback infrastructure and uses multiple obfuscation techniques including dynamic code loading, reflection, and encrypted assets to hinder analysis.",
      "author_name": "AlienVault",
      "modified": "2026-11-19T10:36:11.365000",
      "created": "2026-11-19T07:08:23.467000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
