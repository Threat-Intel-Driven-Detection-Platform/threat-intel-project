    {
      "id": "6aeb40b4e681d29bd1496aac",
      "name": "KeyHunter Operation: Harvard Alumni Data, Stanford Applications and LLM Key Theft",
      "description": "A Chinese-speaking threat actor identified as leepsmarts conducted a multi-vector operation combining LLM API credential theft with academic fraud targeting 20 universities. The campaign harvested 2,233 API keys from misconfigured cloud infrastructure across platforms like Vercel, Netlify, and Railway, with 12 marked valid. The actor created fraudulent student accounts at institutions including NYU, UC Berkeley, and Oregon State, while processing 195 Harvard alumni records from a torrent-distributed dataset. The operation employed AI agent frameworks through Telegram bots for automated scanning, validation, and account creation. Parallel financial fraud activities included a Harmony ONE cryptocurrency drainer capturing victim seed phrases and credit card validation using stolen Stripe merchant keys. Infrastructure spanning China, South Korea, Malaysia, and the US was discovered through an exposed directory listing revealing tools, scripts, and operational logs dating back to January 2026.",
      "author_name": "AlienVault",
      "modified": "2026-11-04T19:03:15.198000",
      "created": "2026-11-04T14:27:00.647000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "leepsmarts",
