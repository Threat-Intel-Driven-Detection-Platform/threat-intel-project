    {
      "id": "6ad792526e0187a3956df84e",
      "name": "Midnight Mimosa Malware Campaign Exploits Android Firmware Supply Chain",
      "description": "Midnight Mimosa is a widespread Android malware campaign involving malicious applications preinstalled in firmware of low-cost MediaTek-based devices, with infections observed across more than 150 countries. The campaign leverages platform-signed system applications to silently deploy payloads, evade mobile security protections, execute remotely supplied code, and monetize compromised devices through advertising fraud and residential-proxy services. The malicious firmware components provide persistent system-level access before device activation, bypass conventional Android security controls by temporarily disabling Google Play Store protections, and maintain privileged positions while operators rotate payloads remotely. Affected devices include low-cost Android handsets, counterfeit flagship models, and devices associated with Doogee and Cubot products, with highest concentrations reported in Mexico, France, and Italy.",
      "author_name": "AlienVault",
      "modified": "2026-10-21T06:50:52.241000",
      "created": "2026-10-20T16:09:54.663000",
      "revision": 2,
      "tlp": "white",
