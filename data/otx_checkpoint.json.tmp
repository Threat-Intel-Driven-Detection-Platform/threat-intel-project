    {
      "id": "6b00587c86464de890abdca1",
      "name": "An AI-Augmented Cybercrime Operation",
      "description": "A French-speaking operator with minimal technical skills conducted a nine-day campaign in November 2026 targeting European banks, insurers, payment providers and municipalities using a jailbroken AI agent. The operator issued 1,801 plain-language commands in misspelled French while the AI agent autonomously wrote scanners, exploits, parsers and exfiltration scripts. The campaign exploited an exposed staging server containing prompt logs, stolen data, and operational tooling. More than 50 organizations across Belgium, France and Switzerland were targeted, resulting in successful breaches at an insurer and multiple municipalities through exposed analytics tools, weak passwords and unauthenticated endpoints. Standard security controls including MFA, IP allowlisting and server-side validation stopped exploitation attempts. The operation ceased when the model API key was revoked on November 14, 2026.",
      "author_name": "AlienVault",
      "modified": "2026-11-23T10:40:51.703000",
      "created": "2026-11-20T14:26:04.851000",
      "revision": 2,
      "tlp": "white",
