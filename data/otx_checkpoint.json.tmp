    {
      "id": "6b0470a2fa16d437c0e84abf",
      "name": "RevStealer Malware: A Hidden Data Heist Behind the Promise of Free AI",
      "description": "RevStealer is an infostealer first identified in September 2026 targeting Windows systems through trojanized Electron applications disguised as legitimate software, particularly a fake Claude Opus 5 Free Desktop lure. Distributed via GitHub repositories and game-cheat sites, the malware employs sophisticated evasion techniques including anti-debugging, anti-sandbox, anti-VM capabilities, and AES-256-CBC encryption. It conducts comprehensive data theft, harvesting browser credentials, session cookies, cryptocurrency wallets, VPN configurations, Windows Credential Manager data, password managers, messaging applications, and user documents. The malware features encrypted command-and-control communications with blockchain-based fallback using Polygon smart contracts, performs streaming exfiltration of stolen data, and self-deletes to minimize forensic traces rather than maintaining persistence. This rapid theft-focused execution model creates immediate compromise risks with minimal detection windows.",
      "author_name": "AlienVault",
      "modified": "2026-11-23T17:07:15.479000",
      "created": "2026-11-23T16:58:10.790000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
