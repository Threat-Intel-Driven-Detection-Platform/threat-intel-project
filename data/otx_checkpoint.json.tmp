    {
      "id": "6a3ba45b3fef31b3a05d9cb0",
      "name": "AsyncRAT and Remcos Delivered in Multi-Stage Phishing Campaign",
      "description": "A global phishing campaign targets business functions with emails carrying malicious Excel attachments that initiate a multi-stage infection chain when macros are enabled.\nThe attack uses layered obfuscation, including HTA scripts, PowerShell, encoded payloads, and steganography in PNG files, to deliver and execute Remote Access Trojans such as Remcos and AsyncRAT in a largely fileless manner.\nIt achieves scale and persistence through high variability, automation, disposable infrastructure, and consistent patterns that help evade detection despite relatively simple techniques.",
      "author_name": "AlienVault",
      "modified": "2026-07-25T15:37:08.792000",
      "created": "2026-06-24T09:33:15.810000",
      "revision": 6,
      "tlp": "white",
      "public": 1,
      "adversary": "",
