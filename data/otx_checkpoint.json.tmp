    {
      "id": "6ad8d87ee8e0fe132bce49d2",
      "name": "Amazon-Themed ClickFix Campaign Serves Up Finger-Licking Malware",
      "description": "Attackers leveraged a sponsored Google search result for 'amazon business' to redirect victims to a spoofed Amazon login page hosted on Google Sites. The page presented a fake CAPTCHA (ClickFix) that tricked users into executing a malicious command using Windows' finger utility, an obsolete network tool repurposed as a living-off-the-land binary. This initiated a complex infection chain downloading IronPython, executing obfuscated Python scripts, and deploying multiple payloads including Doina malware, Lumma Stealer via a Node.js package, and a pirated NetSupport Client RMM tool. The attack infrastructure predominantly used barbecue-themed domains for command and control. The campaign affected multiple organizations and demonstrates cross-platform capabilities, with alternate payloads prepared for macOS users. Attackers employed sophisticated obfuscation techniques including Base64 encoding with Cyrillic character substitution, XOR encryption, and RC4 decryption throughout the infection stages.",
      "author_name": "AlienVault",
      "modified": "2026-11-20T15:01:55.620000",
      "created": "2026-10-21T15:21:34.337000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
