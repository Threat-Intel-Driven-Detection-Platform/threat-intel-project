    {
      "id": "6b0043f873dc92a1ab3560c9",
      "name": "Uncovered and Disrupted BADBOX 3.0, the Largest Ad Fraud Operation by Bid Volume Ever Publicly Disclosed",
      "description": "BADBOX 3.0 represents the largest ad fraud operation ever disclosed, generating approximately 40 billion bid requests daily and comprising over 4% of all connected TV traffic. The operation primarily targets low-cost consumer devices infected with backdoors delivering fraud modules linked to TXCZ, a Chinese electronics manufacturer. These modules render invisible video ads while impersonating legitimate applications and enroll devices as exit nodes in eleven residential proxy networks, including PXYEDGE, the successor to IpMoYu from BADBOX 2.0. The operation also employs spoofed server-side ad insertion traffic. The campaign's volume exceeds the previous record holder VASTFLUX by three times and surpasses the combined volume of five years of prior investigations.",
      "author_name": "AlienVault",
      "modified": "2026-11-20T13:03:26.559000",
      "created": "2026-11-20T12:58:32.850000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "TXCZ",
