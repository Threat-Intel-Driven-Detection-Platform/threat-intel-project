    {
      "id": "6acf85338bff164de62a2759",
      "name": "Hirudo: From Fake Updates to Patched Banking Apps",
      "description": "A new Android banking remote access trojan named Hirudo has been identified, combining credential theft with live remote control. It is delivered through shopping and entertainment apps that act as droppers, installing the trojan as a separate package behind fake update prompts. The malware replaces legitimate banking applications with patched versions that disable security checks from within the app itself. Eight Indonesian banking apps covering seven banks have been targeted with purpose-built replacements embedding a hooking engine. The campaign uses real advertising infrastructure including Amazon CloudFront for distribution, with targeting extending beyond Indonesia to China, India, Mexico, Morocco, Thailand, and Malaysia. Backend data from August 2026 revealed thousands of stolen credentials and device records.",
      "author_name": "AlienVault",
      "modified": "2026-11-13T13:01:58.949000",
      "created": "2026-10-14T13:35:47.216000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
