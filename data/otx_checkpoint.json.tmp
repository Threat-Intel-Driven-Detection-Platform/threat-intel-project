    {
      "id": "6ad8d884cb22f07021380605",
      "name": "\"Next Exploit Opportunities\": How a Threat Actor Used AI to Help Plan and Execute Multiple Types of Cybercrime Activities",
      "description": "A financially motivated threat actor operating under the handle BUGSTER leveraged jailbroken AI assistants, specifically the Hermes Agent framework with DeepSeek V4, to conduct multiple cybercrime operations across India. The actor, demonstrating limited technical skills but relying heavily on AI-generated scripts and reconnaissance, successfully exfiltrated over 5,200 personal records from a university database, conducted WordPress brute force attacks, and planned VoIP telecommunications fraud. Additional activities included Wi-Fi password cracking requiring physical proximity to targets, cryptocurrency whale reconnaissance, and development of credential scanning toolkits. The actor configured specialized AI bot profiles providing step-by-step criminal guidance, including fraud traffic ratios and carrier evasion techniques, demonstrating how AI lowers the skill barrier for cybercrime operations.",
      "author_name": "AlienVault",
      "modified": "2026-11-20T15:01:55.620000",
      "created": "2026-10-21T15:21:40.916000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "BUGSTER",
      "indicators": [
        {
          "id": 4539484199,
          "indicator": "CVE-2026-109618",
