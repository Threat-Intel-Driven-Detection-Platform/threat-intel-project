    {
      "id": "6af57629f156de011b1bb497",
      "name": "Beware of Phishing Email Disguised as Quotation Inquiry (SnakeKeylogger)",
      "description": "A phishing campaign disguised as quotation inquiry requests has been observed, where attackers impersonate purchasing team material management personnel requesting quote confirmations. The emails contain compressed attachments that, when extracted, reveal JavaScript files. These execute obfuscated PowerShell scripts that decrypt and run multi-stage payloads using AES-256-CBC encryption and XOR operations. The attack chain utilizes process hollowing techniques to inject the final payload into aspnet_compiler.exe. The ultimate malware is SnakeKeylogger, an infostealer that collects web browser credentials, system information, and keylogging data, exfiltrating it via SMTP or Telegram to attacker-controlled infrastructure.",
      "author_name": "AlienVault",
      "modified": "2026-11-12T09:55:29.919000",
      "created": "2026-11-12T08:17:45.468000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
