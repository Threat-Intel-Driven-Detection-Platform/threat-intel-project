    {
      "id": "6ae307a3ac3f1c968fce54a3",
      "name": "Unknown APT uses NetamLoader to attack a Win10 OS customized for governments in Asia",
      "description": "A sophisticated supply-chain attack has been discovered targeting a custom Windows 10 build used exclusively by government entities in Asia. The attack employs a complex multi-stage infection chain called NetamLoader, leveraging XAML markup and .NET assemblies. The malicious framework begins with a CAB archive placed in Windows update directories, exploiting AppDomainManager injection and BinaryFormatter deserialization vulnerabilities. The attack chain progresses through multiple stages involving XAML loaders, bypasses AMSI protection, and deploys a plugin that communicates with command-and-control infrastructure. The framework uses AES encryption for network traffic, implements anti-analysis techniques including 22-28 hour polling intervals, and removes forensic evidence. The malware operates covertly by migrating to dllhost.exe and uses isolated AppDomains for payload execution. Commercial hosting infrastructure including Cloudflare CDN was utilized.",
      "author_name": "AlienVault",
      "modified": "2026-10-29T15:58:49.625000",
      "created": "2026-10-29T08:45:23.289000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
