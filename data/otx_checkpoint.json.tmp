    {
      "id": "6ae9981a0b51502b1e8d1e4f",
      "name": "BITTER Expands Its Arsenal with PapRAT",
      "description": "A cyberespionage group known as BITTER has been conducting campaigns targeting South Asian organizations using PowerShell scripts and a custom remote access trojan called PapRAT. Three distinct infection chains have been identified: one exploiting Windows ftp.exe with malicious LNK files, another using VHDX disk images containing MSI installers, and a third combining URL shortcuts with WebDAV to deploy PapRAT. The malware exists in both C++ and Rust implementations, with capabilities including command execution, file manipulation, directory enumeration, screenshot capture, and secondary payload delivery. PapRAT maintains persistent access through scheduled tasks and communicates with command-and-control servers over HTTP. The Rust variant introduces enhanced functionality including PowerShell execution and sleep commands. Targets are concentrated in South Asian government, energy, and engineering sectors.",
      "author_name": "AlienVault",
      "modified": "2026-11-03T09:05:53.559000",
      "created": "2026-11-03T08:15:22.006000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "HAZY TIGER",
