    {
      "id": "6b042f8d0739278a44479afb",
      "name": "Lost in relocation: analysis of a new loader distributing CASTLESTEALER",
      "description": "A previously undocumented Windows loader tracked as OXLOADER delivers the CASTLESTEALER infostealer through malicious Google Ads campaigns. The loader employs sophisticated evasion techniques including control-flow flattening, mixed Boolean-Arithmetic obfuscation, and abuse of the Windows .reloc section to stage shellcode. It incorporates five anti-VM and language checks, self-modifying decryption stubs, and masquerades as legitimate software like Node.js or API Monitor. CIS-region and Russian-language exclusions suggest a financially motivated, Russian-speaking threat actor. The loader achieves low detection rates across static engines and sandboxes, with victims redirected through intermediary domains to Storj-hosted batch scripts that download and execute the payload. The final stage uses DonutLoader to deliver CASTLESTEALER in-memory, targeting credentials and sensitive information.",
      "author_name": "AlienVault",
      "modified": "2026-11-23T16:49:20.429000",
      "created": "2026-11-23T12:20:29.035000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
