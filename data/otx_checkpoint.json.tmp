    {
      "id": "6ae30926ecb75953084b298e",
      "name": "Fake \"View & Sign\" and Adobe Acrobat Lures Deliver Attacker-Configured ScreenConnect Clients",
      "description": "Researchers uncovered fake Adobe Acrobat and \"View & Sign\" pages distributing legitimate, digitally signed ConnectWise ScreenConnect installers configured for unauthorized remote access. The campaign uses Telegram bots to track visitors, profile devices and networks, and automatically download remote-access clients when specific criteria are met. Five distinct page variants share near-identical JavaScript and common background images, applying operating-system and ISP-based checks before delivery. The installers connect to separate ScreenConnect Cloud tenants including omydze, vvvzou, luminahealthturkey2, tfcconnection, and alunos1. If executed, these clients establish persistent remote access running as LocalSystem. The threat weaponizes trusted software with valid digital signatures to bypass traditional security controls, requiring defenders to focus on identifying unauthorized tenant configurations rather than relying solely on file hashes.",
      "author_name": "AlienVault",
      "modified": "2026-10-29T16:00:01.739000",
      "created": "2026-10-29T08:51:50.353000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
