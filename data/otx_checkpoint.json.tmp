    {
      "id": "6ae9eb16f9bae7d0faed8d7a",
      "name": "Yoba Malware Campaign Abuses Signed AI Applications to Evade Detection",
      "description": "A sophisticated campaign tracked as Yoba distributes cryptocurrency mining malware through fraudulent GitHub repositories impersonating ChatGPT and Claude AI applications. Attackers leverage legitimate, digitally signed executables from OpenAI and Anthropic alongside malicious DLLs to achieve DLL sideloading, evading detection through trusted software signatures. The multistage infection chain employs YobaDropper and YobaLoader components with anti-analysis techniques including process verification, execution delays, and regional language exclusions. C2 communication leverages Telegram profile imagery combined with domain generation algorithms, DNS over HTTPS via Google, and public hosting services like Catbox to retrieve encrypted payloads. While XMRig cryptocurrency miner deployment was observed, the loader architecture supports additional Windows executables and PowerShell payloads, suggesting potential expansion beyond cryptojacking operations.",
      "author_name": "AlienVault",
      "modified": "2026-11-03T16:27:15.097000",
      "created": "2026-11-03T14:09:26.963000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
      "indicators": [
        {
          "id": 2199241492,
          "indicator": "CVE-2017-7921",
          "type": "CVE",
          "created": "2026-11-03T14:09:27",
