    {
      "id": "6ae463fa75713227e9492efc",
      "name": "Trojanized Claude Code Extension Plants an SSH Backdoor",
      "description": "Version 2.1.313 of the Claude Code extension in the Cursor Marketplace was compromised on October 29th, 2026. A malicious 66-line loader was inserted before legitimate extension code in the extension.js file. Upon activation, it adds an attacker-controlled SSH key labeled 'svc-telemetry' to the victim's authorized_keys, attempts to enable local SSH services, and establishes a reverse SSH tunnel to 134.209.82.225. The implant collects reconnaissance data including hostname, user information, Git configuration, and environment variables containing credentials. It installs platform-specific persistence mechanisms using LaunchAgents on macOS, crontab on Linux, and scheduled tasks on Windows. Beacon data is transmitted unencrypted to the command-and-control infrastructure, providing persistent remote access through the established SSH tunnel.",
      "author_name": "AlienVault",
      "modified": "2026-10-30T09:55:43.571000",
      "created": "2026-10-30T09:31:38.559000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
      "indicators": [
