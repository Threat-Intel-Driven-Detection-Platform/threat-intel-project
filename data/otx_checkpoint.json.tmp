    {
      "id": "6af6dd4e596db4bd8d7a709b",
      "name": "ESXi ransomware: why it is dangerous and how to defend against it",
      "description": "A recent investigation revealed how adversaries systematically destroyed an organization's virtualization estate over ten days by compromising four ESXi hosts, all virtual machines, both vCenter Server Appliances, and backup infrastructure. The attackers, identified as BlackNevas, exploited legitimate VMware management interfaces without using vulnerabilities. They gained access through compromised credentials from non-virtualization systems, established persistence using MeshAgent and Ligolo-ng on vCenter appliances, then leveraged Host Profiles to enable SSH on ESXi hosts. The payload was delivered via SFTP and executed selective overwrites of virtual disk files while backup systems were disrupted first. This demonstrates how hypervisor compromise through valid credentials and administrative features poses severe risk, requiring architectural defenses including treating vCenter as Tier 0 assets, separating virtualization identities from enterprise administration, implementing independent logging infrastr...",
      "author_name": "AlienVault",
      "modified": "2026-11-13T10:07:23.042000",
      "created": "2026-11-13T09:50:06.278000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "Trial Recovery",
      "indicators": [
        {
          "id": 2873200793,
          "indicator": "CVE-2021-21972",
          "type": "CVE",
          "created": "2026-11-13T09:50:07",
