    {
      "id": "6adb86a013dc27c6c19d3f3c",
      "name": "Infostealer riding the AI Train",
      "description": "Aokigahara is a newly identified infostealer with traditional data theft capabilities targeting browsers, VPN clients, cryptocurrency wallets, FTP/SFTP clients, password managers, and email applications. Its distinguishing feature is dedicated targeting of AI applications and development tools, including Claude, ChatGPT Desktop, Codex, Cursor, Windsurf, GitHub Copilot, and Gemini CLI. The malware collects authentication files, session data, and configuration files from these AI services, alongside developer credentials such as Git files, SSH private keys, and AWS, Azure, and Google Cloud credentials. Stolen AI credentials could enable unauthorized access to paid services, account resale, or data extortion. The stealer employs anti-analysis techniques including language checks, virtual machine detection, and control-flow flattening, and uses AES-256 encryption with X25519 key exchange for command-and-control communications.",
      "author_name": "AlienVault",
      "modified": "2026-11-22T16:05:49.212000",
      "created": "2026-10-23T16:09:04.500000",
      "revision": 2,
      "tlp": "white",
