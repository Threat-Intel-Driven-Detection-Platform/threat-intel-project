    {
      "id": "6afd5c42c6e50b8c437fe592",
      "name": "US Logistics Cyber Threats: 3 Campaigns & Defense",
      "description": "Three distinct campaigns are actively targeting the US trucking and logistics sector through fraudulent business portals and malicious documents. HelloFriends uses fake FMCSA carrier verification portals to harvest credentials, SSNs, EINs, and fuel card information through phishing emails. NodeRemote distributes backdoors disguised as broker onboarding documents, establishing persistent access through scheduled tasks and rotating C2 infrastructure. Fake Freight Portals impersonate TIMOCOM and DAT platforms, delivering MeshCentral and CastleRAT through malicious WebDAV shortcuts while attempting to extract BitLocker recovery keys. These attacks exploit routine logistics workflows including carrier verification, broker onboarding, and freight booking. The campaigns demonstrate sophisticated social engineering, infrastructure rotation, and multi-stage infection chains that combine credential theft with persistent remote access capabilities.",
      "author_name": "AlienVault",
      "modified": "2026-11-18T09:35:24.992000",
      "created": "2026-11-18T08:05:22.151000",
      "revision": 2,
      "tlp": "white",
      "public": 1,
      "adversary": "",
