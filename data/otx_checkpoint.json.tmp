    {
      "id": "6ae095c663fb4a4ea6376f77",
      "name": "DarkCore: A Data-Theft RAT With a Session-Hijacking Browser",
      "description": "Security researchers uncovered DarkCore, a remote access trojan distributed through cybercrime networks with advanced credential theft and session hijacking capabilities. The threat features a dedicated browser that reuses stolen session cookies to access Gmail, WhatsApp, MediaFire and other services while routing traffic through victims' IP addresses to masquerade as legitimate activity. DarkCore also includes hidden virtual network computing (HVNC) for concealed desktop access, credential managers displaying usernames and passwords, and reverse proxy functionality. Distribution occurs via PDF-themed shortcuts that download decoy documents alongside malicious executables. The native C++ tool communicates with command-and-control infrastructure via direct TCP connections and can load additional modules either in-memory or as temporary DLL files for extended functionality.",
      "author_name": "AlienVault",
      "modified": "2026-10-27T15:21:22.851000",
      "created": "2026-10-27T12:15:02.566000",
      "revision": 3,
      "tlp": "white",
